<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<style>
    .pagination a {
        margin: 0 5px;
        text-decoration: none;
        padding: 5px 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .pagination a.active {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
    }

    html,
    body {
        height: 100%;
    }

    .wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .content-wrapper {
        flex: 1;
        padding: 20px;
        background-color: #f4f6f9;
    }

    .main-footer {
        background: #fff;
        border-top: 1px solid #dee2e6;
        color: #6c757d;
        padding: 10px 20px;
        margin-left: 250px;
        /* Sesuaikan dengan lebar sidebar */
    }
</style>

<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <%- include('layout/header') %>
        <%- include('layout/sidebar') %>
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                        <h3>Finance History</h3>
                        </div>
                        <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <% if (role === 1 || role === 10 || role === 11 || role === 12) { %>
                            <div class="mb-2 text-right">
                            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modal-lg">Add SO / DO</button>
                            </div>
                            <% } %>
                        </ol>
                        </div>
                    </div>
                </div>
            </div>
            <% if (successMessage && successMessage.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= successMessage %>
                <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
                    &times;
                </button>
            </div>
            <% } %>

            <% if (errorMessage && errorMessage.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= errorMessage %>
                <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
                    &times;
                </button>
            </div>
            <% } %>
            <section class="content p-0">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="form-inline row g-2">
                            <div class="col-auto">
                                <a href="soDo" class="btn btn-sm btn-warning">Kembali</a>
                            </div>
                            <!-- <form> -->
                            <div class="col-auto">
                                <input type="text" id="search" name="search" class="form-control form-control-sm"
                                    placeholder="Cari di SO / DO" style="width: 30ch;">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateStart" name="filterDateStart"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateEnd" name="filterDateEnd"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <button id="filterButton" class="btn btn-sm btn-primary">Filter</button>
                                <button id="resetButton" class="btn btn-sm btn-secondary">Reset</button>
                            </div>
                            <!-- </form> -->
                        </div>
                    </div>
                    <!---end card-header -->
                    <!-- Table Content -->
                    <div class="card-body table-responsive">
                        <table id="soDoTable"
                            class="table table-bordered table-striped table-hover table-sm align-middle"
                            style="width:100%; table-layout: fixed; font-size: 15px;">
                            <thead>
                                <tr>
                                    <th style="width: 35px; text-align: center; vertical-align: middle;">No</th>
                                    <th style="width: 105px; text-align: center; vertical-align: middle;">Sales Order Number</th>
                                    <th style="width: 105px; text-align: center; vertical-align: middle;">Delivery Order Number</th>
                                    <th style="width: 120px; text-align: center; vertical-align: middle;">Delivery Order Date</th>
                                    <th style="width: 90px; text-align: center; vertical-align: middle;">Location</th>
                                    <th style="width: 200px; text-align: center; vertical-align: middle;">Customer</th>
                                    <th style="width: 150px; text-align: center; vertical-align: middle;">Divisi</th>
                                    <th style="width: 120px; text-align: center; vertical-align: middle;">Info ke Invoicing Diterima</th>
                                    <th style="width: 150px; text-align: center; vertical-align: middle;">Ship By</th>
                                    <th style="width: 120px; text-align: center; vertical-align: middle;">Resi Number</th>
                                    <th style="width: 120px; text-align: center; vertical-align: middle;">ETA</th>
                                    <th style="width: 150px; text-align: center; vertical-align: middle;">Nama Penerima</th>
                                    <th style="width: 100px; text-align: center; vertical-align: middle;">Harga Ongkir</th>
                                    <th style="width: 70px; text-align: center; vertical-align: middle;">Berat</th>
                                    <th style="width: 80px; text-align: center; vertical-align: middle;">Status</th>
                                </tr>
                            </thead>
                            <tbody id="searchResults">
                                <% if (data && data.length > 0) { %>
                                <% data.forEach((item, index) => { %>
                                <tr id="row-<%= item.id_monitoring_data %>">
                                    <td style="text-align: center; vertical-align: middle;"><%= (currentPage - 1) * itemsPerPage + index + 1 %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.sales_order_number %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.delivery_order_number %></td>
                                    <td  style="text-align: center; vertical-align: middle;">
                                        <%= new Date(item.delivery_order_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }).replace(/ /g, '-') %>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.location_warehouse %></td>
                                    <td style="vertical-align: middle;"><%= item.customer_name %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.name_division %></td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <% if (item.invoicing_date) { %>
                                        <%= new Date(item.invoicing_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }).replace(/ /g, '-') %>
                                        <% } else { %>
                                        <span class="badge badge-danger">Belum diinput oleh Tim Finance</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <% if (item.ship_by) { %>
                                        <%= item.ship_by %>
                                        <% } else { %>
                                        <span class="badge badge-danger">Pengirim atau Ekspedisi belum diinput</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.resi_number%></td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <% if (item.eta) { %>
                                        <%= new Date(item.eta).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }).replace(/ /g, '-') %>
                                        <% } else { %>
                                        <span class="badge badge-danger">Tanggal ETA belum diinput</span>
                                        <% } %>
                                    </td>
                                    <td style="vertical-align: middle;"><%= item.receive_name %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.price %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.weight %></td>
                                    <td style="text-align: center; vertical-align: middle;"><%= item.status %></td>    
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="15" class="text-center">Tidak ada data</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!---end Table Content-->
                    <div class="d-flex justify-content-center mt-3">
                        <% const pageLimit = 5; 
                        const startPage = Math.max(1, currentPage - Math.floor(pageLimit / 2));
                        const endPage = Math.min(totalPages, startPage + pageLimit - 1);
                        const queryString = `search=${encodeURIComponent(searchKeyword || '')}&filterDateStart=${filterDateStart || ''}&filterDateEnd=${filterDateEnd || ''}`;
                        %>
                        <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=1&<%= queryString %>">&laquo; First</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= queryString %>">Prev</a>
                            </li>
                            <% } %>

                            <% for (let i = startPage; i <= endPage; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>&<%= queryString %>"><%= i %></a>
                            </li>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= queryString %>">Next</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= totalPages %>&<%= queryString %>">Last &raquo;</a>
                            </li>
                            <% } %>
                        </ul>
                        </nav>
                    </div>
                    <br>
                    <!---END pagination-->
                </div>
                <!-- end Card Table -->
            </section>
        </div>
    </div>
    <%- include('layout/footer') %>
</body>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode"></script>
<script>
    document.getElementById('resetButton').addEventListener('click', function (e) {
        e.preventDefault();
        window.location.href = `/historyFinance`;
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const filterButton = document.getElementById('filterButton');
        const searchInput = document.getElementById('search');
        const startDate = document.getElementById('filterDateStart');
        const endDate = document.getElementById('filterDateEnd');

        filterButton.addEventListener('click', function (e) {
            e.preventDefault(); // Hindari submit form default

            const query = new URLSearchParams();

            if (searchInput.value.trim() !== '') {
                query.append('search', searchInput.value.trim());
            }
            if (startDate.value) {
                query.append('filterDateStart', startDate.value);
            }
            if (endDate.value) {
                query.append('filterDateEnd', endDate.value);
            }

            window.location.href = `/historyFinance?${query.toString()}`;
        });
    });
</script>