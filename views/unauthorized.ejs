<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Halaman Tidak Ditemukan</title>

    <!-- AdminLTE CSS -->
    <link
      rel="stylesheet"
      href="/adminlte/dist/css/adminlte.min.css"
    />
    <!-- Optional: Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      body {
        background-image: url("/adminlte/dist/img/404orang.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1rem;
        padding-top: 50px; /* beri jarak dari logo yang fixed */
      }

      .logo-header {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 999;
      }

      .logo-header img {
        width: 150px;
        height: auto;
      }

      .content-404 {
        max-width: 600px;
      }

      .content-404 h1 {
        font-size: 60px;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #dc3545;
      }

      .content-404 h2 {
        font-size: 25px;
        margin-bottom: 1rem;
      }

      .content-404 p {
        font-size: 15px;
        margin-bottom: 1.5rem;
      }

      @media (max-width: 576px) {
        .content-404 h1 {
          font-size: 60px;
        }

        .content-404 h2 {
          font-size: 20px;
        }

        .content-404 p {
          font-size: 14px;
        }

        .logo-header img {
          width: 120px;
        }
      }
    </style>
  </head>

  <body>
    <!-- Logo ABN fixed di header -->
    <div class="logo-header">
      <img
        src="/adminlte/dist/img/logoabn.png"
        alt="Logo ABN"
      />
    </div>

    <div class="content-404">
      <p class="mb-0">Ehh...</p>
      <h1>404</h1>
      <h2>Halaman tidak tersedia</h2>
      <p>Anda tidak memiliki akses ke halaman ini.</p>
      <a href="/login" class="btn btn-primary text-light fw-bold">
        Kembali ke Halaman Login
      </a>
    </div>
  </body>
</html>
