<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>e-Warranty Registration - Abadi Nusa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #cbd0d8;
            font-family: Arial, sans-serif;
            padding: 2rem;
        }

        .form-container {
            background-color: #fff;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            max-width: 1000px;
            margin: 0 auto;
        }

        h2 {
            text-align: center;
            font-weight: bold;
            margin-bottom: 1.5rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-label {
            font-weight: 600;
        }

        .btn-submit {
            background-color: #2eaf7d;
            color: white;
            border: none;
        }

        .alert {
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-weight: bold;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }

        .autofilled {
            background-color: #e9ecef;
            /* sama seperti disabled */
            color: #6c757d;
            /* warna teks seperti disabled */
            cursor: not-allowed;
        }

        @media (max-width: 576px) {
            .form-container {
                padding: 1rem;
            }
        }

        @media (prefers-color-scheme: dark) {
            body {
                background-color: #1c1c1c;
                color: #f1f1f1;
            }

            .form-container {
                background-color: #2a2a2a;
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
            }

            .form-control,
            .form-select {
                background-color: #3a3a3a;
                color: #f1f1f1;
                border: 1px solid #555;
            }

            .form-control::placeholder {
                color: #aaa;
            }

            .form-check-label {
                color: #f1f1f1;
            }

            .alert-danger {
                background-color: #5f1b1f;
                color: #f8d7da;
            }

            .alert-success {
                background-color: #1b3f1f;
                color: #d4edda;
            }

            .btn-submit {
                background-color: #4caf88;
            }

            /* T&C box */
            .tnc-container {
                background-color: #2a2a2a !important;
                color: #f1f1f1;
                border-color: #444;
            }

            .tnc-container strong {
                color: #ffffff;
            }

            .tnc-container ul li {
                color: #ddd;
            }
        }

    </style>
</head>

<body>
    <div class="form-container">
        <a>
            <img src="/adminlte/dist/img/logoabn.png" alt="logo"
                style="max-width: 200px; display: block; margin: 0 auto" />
        </a>
        <h2>e-Warranty Registration</h2>
        <hr class="my-4">
        <div class="mt-3 p-3 border rounded bg-light tnc-container" style="font-size: 0.9rem;">
            <strong>Terms and Conditions:</strong>
            <ul style="margin-top: 0.5rem;">
                <li>The warranty is valid for 1 (one) year from the installation or purchase date from <strong> PT. Abadinusa Usahasemesta.</strong></li>
                <li>Filling in the <strong>Color</strong> and <strong>Serial Number</strong> fields is mandatory (especially for Stethoscopes). If the product does not have a Serial Number, please enter <strong>"-”</strong>.</li>
                <li>Shipping costs for warranty claims are fully borne by the <strong>Customer</strong>.</li>
                <li>If you need further assistance, feel free to contact our <strong>Customer Service</strong> team:</li>
                <ul>
                    <li>Phone/WhatsApp: 0811 131 0131</li>
                    <li>Email: workshop@abadinusa.co.id / servicecenter@abadinusa.co.id</li>
                </ul>
            </ul>
        </div>
        <hr class="my-4">
        <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger"><%= errorMessage[0] %></div>
        <% } %> <% if (successMessage && successMessage.length > 0) { %>
        <div class="alert alert-success"><%= successMessage[0] %></div>
        <% } %>

        <form action="/ewarranty/createEwarranty" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="uuid" value="<%= uuid %>">
            <div class="row">
                <!-- KIRI -->
                <div class="col-md-6">
                    <!-- Customer Info -->
                    <input type="hidden" name="doNumber" value="doNumber"/>
                    <div class="form-group">
                        <label class="form-label">Customer Name</label>
                        <input type="text" class="form-control" name="customer_name" placeholder="Customer Name" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Company Name</label>
                        <input type="text" class="form-control" name="company_name" placeholder="Company Name" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Institution Type</label>
                        <select class="form-control" id="institution" name="institution" >
                            <option value="">-- Select Institution Type --</option>
                            <option value="Government">Government</option>
                            <option value="Company">Private Company</option>
                            <option value="Institute">Educational Institute</option>
                            <option value="Hospital">Hospital</option>
                            <option value="Private">Individual / Personal</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="email" placeholder="name@domain.com"  pattern="^[^@]+@[^@]+\.[^@]+$"  />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone Number</label>
                        <input type="text" class="form-control" name="phone" placeholder="082XXXXXXXXX" inputmode="numeric" pattern="^0[0-9]{9,14}$" title="Phone number must start with 0 and be 10–15 digits long" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Address</label>
                        <textarea class="form-control" name="address" style="height: 123px; resize: none"
                            placeholder="Address" ></textarea>
                    </div>
                </div>

                <!-- KANAN -->
                <div class="col-md-6">
                    <!-- Product Info -->
                    <div class="form-group">
                        <label class="form-label">Product Brand</label>
                        <input type="text" class="form-control" name="product_brand" placeholder="Product Brand" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Product Name</label>
                        <input type="text" class="form-control autofilled" name="product_name"
                            placeholder="Product Name" value="<%= dataProduct[0]?.product_name || '-' %>" readonly />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Catalog Number</label>
                        <input type="text" class="form-control <%= dataProduct[0]?.no_catalog ? 'autofilled' : '' %>"
                            name="catalog_number"
                            placeholder="<%= dataProduct[0]?.no_catalog ? 'Catalog Number' : 'Enter - if no value.' %>"
                            value="<%= dataProduct[0]?.no_catalog || '' %>"
                            <%= dataProduct[0]?.no_catalog ? 'readonly' : 'readonly' %> />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Serial Number Product</label>
                        <input type="text" class="form-control <%= dataProduct[0]?.serial_number ? 'autofilled' : '' %>"
                            name="serial_number"
                            placeholder="<%= dataProduct[0]?.serial_number ? 'Serial Number Product' : 'Enter - if no value.' %>"
                            value="<%= dataProduct[0]?.serial_number || '' %>"
                            <%= dataProduct[0]?.serial_number ? 'readonly' : '' %> />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Color</label>
                        <input type="text" class="form-control" name="color" placeholder="Product Color" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Purchase Date</label>
                        <input type="date" class="form-control" name="purchase_date"  />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Purchase From</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="purchase_method" value="Online" />
                            <label class="form-check-label">Online</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="purchase_method" value="Direct" />
                            <label class="form-check-label">Direct</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="purchase_method" value="Distributor" />
                            <label class="form-check-label">Distributor</label>
                        </div>
                    </div>

                </div>
                <div class="form-group">
                    <label class="form-label">Installation Date / Date Received</label>
                    <input type="date" class="form-control" name="installation_date"  />
                </div>
                <!-- Upload Foto Produk / Tanda Terima -->
                <div class="form-group">
                    <label class="form-label">Upload Product Receipt</label>
                    <input type="file" class="form-control" name="attachment" accept=".jpg,.jpeg,.png,.pdf"  />
                    <small class="form-text text-muted">Max file size: 10MB</small>
                </div>
            </div>

            <!-- Tombol Submit -->
            <div class="mt-3">
                <button type="submit" class="btn btn-submit w-100">
                    Submit Warranty
                </button>
            </div>
        </form>
    </div>
</body>

</html>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault(); // stop submit dulu

        const Fields = [
            { name: "customer_name", label: "Customer Name" },
            { name: "company_name", label: "Company Name" },
            { name: "institution", label: "Institution Type" },
            { name: "email", label: "Email" },
            { name: "phone", label: "Phone Number" },
            { name: "address", label: "Address" },
            { name: "product_brand", label: "Product Brand" },
            { name: "purchase_date", label: "Purchase Date" },
            { name: "purchase_method", label: "Purchase From" },
            { name: "installation_date", label: "Installation Date / Date Received" },
            { name: "attachment", label: "Upload Product Receipt" }
        ];

        const missingFields = [];
        const emailField = form.querySelector('[name="email"]');
        const phoneField = form.querySelector('[name="phone"]');
        const fileInput = form.querySelector('input[name="attachment"]');

        // 🔍 Cek field kosong
        Fields.forEach(field => {
            const input = form.querySelector(`[name="${field.name}"]`);
            if (!input) return;

            if (input.type === "radio") {
                const checked = form.querySelectorAll(`[name="${field.name}"]:checked`);
                if (checked.length === 0) missingFields.push(field.label);
                return;
            }

            if (input.tagName === "SELECT") {
                if (!input.value || input.value.trim() === "") {
                    missingFields.push(field.label);
                }
                return;
            }

            if (input.type === "file") {
                if (!input.files || input.files.length === 0) {
                    missingFields.push(field.label);
                }
                return;
            }

            if (!input.value || input.value.trim() === "") {
                missingFields.push(field.label);
            }
        });

        // 📧 Validasi email format
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailField.value && !emailRegex.test(emailField.value)) {
            missingFields.push("Invalid Email Format");
        }

        // 📱 Validasi nomor HP format
        const phoneRegex = /^0[0-9]{9,14}$/;
        if (phoneField.value && !phoneRegex.test(phoneField.value)) {
            missingFields.push("Invalid Phone Number (use format 08XXXXXXXXX)");
        }

        // ❌ Kalau ada yang belum diisi atau invalid
        if (missingFields.length > 0) {
            return Swal.fire({
                icon: 'error',
                title: 'Form Incomplete / Invalid',
                html: `<ul style="text-align:left">${missingFields.map(f => `<li>${f}</li>`).join('')}</ul>`,
                confirmButtonColor: '#2eaf7d'
            });
        }

        // 📂 Validasi file size (max 10 MB)
        const file = fileInput.files[0];
        const maxSizeMB = 10;
        const maxSizeBytes = maxSizeMB * 1024 * 1024;
        if (file && file.size > maxSizeBytes) {
            return Swal.fire({
                icon: 'error',
                title: 'File too large!',
                text: `Maximum size is ${maxSizeMB} MB.`,
                confirmButtonColor: '#2eaf7d'
            });
        }

        // ✅ Konfirmasi sebelum submit
        const result = await Swal.fire({
            title: 'Submit e-Warranty?',
            text: "Are you sure you want to submit this e-Warranty?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#2eaf7d',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Submit',
            cancelButtonText: 'Cancel'
        });

        if (result.isConfirmed) {
            form.submit();
        }
    });
});
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        if (params.get('error') === '413') {
            Swal.fire({
                icon: 'error',
                title: 'File Too Large!',
                text: 'Maximum allowed file size is 10MB.',
                confirmButtonColor: '#2eaf7d'
            });
        }
    });
</script>
