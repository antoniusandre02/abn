<aside class="main-sidebar sidebar-dark-primary elevation-4">
  <!-- Brand Logo -->
  <a href="/" class="brand-link">
    <img src="/adminlte/dist/img/logoabn.png" alt="logo" style="width: 100%; max-width: 150px; height: auto; display: block;">
  </a>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false">
        
        <% if ([1].includes(user.role)) { %>
        <!-- Create Account: Admin  -->
        <li class="nav-item">
          <a href="/createAccounts" class="nav-link">
            <i class="nav-icon fas fa-users"></i>
            <p>Create Accounts</p>
          </a>
        </li>
        <% } %>
        
        <% if ([1].includes(user.role)) { %>
        <li class="nav-item">
          <a href="/uploadSODO" class="nav-link">
            <i class="nav-icon fas fa-file"></i>
            <p>Upload SO / DO</p>
          </a>
        </li>
        <% } %>
        
        <li class="nav-item">
          <a href="/dashboard" class="nav-link">
            <i class="nav-icon fas fa-tv"></i>
            <p>Display Monitoring</p>
          </a>
        </li>

        <% if ([1, 8, 10, 11].includes(user.role)) { %>
        <!-- SO / DO: Admin, Finance, Admin Gudang -->
        <li class="nav-item">
          <a href="/soDo" class="nav-link">
            <i class="nav-icon fas fa-file-alt"></i>
            <p>SO / DO</p>
          </a>
        </li>
        <% } %>

        <% if ([1, 2, 3, 4, 5, 6, 7].includes(user.role)) { %>
        <!-- Scan Barcode: Admin dan semua Operator -->
        <li class="nav-item">
          <a href="/scanBarcode" class="nav-link">
            <i class="nav-icon fas fa-barcode"></i>
