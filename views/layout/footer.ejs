<script>
  $(function () {
    console.log('All JS Loaded');

    // Manual init dropdown
    $('.dropdown-toggle').dropdown();

    // Debug sidebar toggle
    $('[data-widget="pushmenu"]').on('click', function () {
      console.log('Sidebar toggle clicked');
    });

    // Aktifkan treeview dropdown di sidebar (jika ada)
    $('[data-widget="treeview"]').Treeview?.('init');

    // Fallback manual treeview (kalau auto-init tidak bekerja)
    $('.nav-sidebar .has-treeview > a').on('click', function (e) {
      const parent = $(this).parent();
      const submenu = parent.find('.nav-treeview').first();
      submenu.slideToggle(200);
      parent.toggleClass('menu-open');
    });
  });
</script>

