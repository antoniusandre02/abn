<%- include('layout/header') %>
<%- include('layout/sidebar') %>

<div class="container">
    <h2 class="mb-4">Pippete Calibration Form</h2>

    <form action="/pipette/createPipetteCalibration" method="POST" id="calibrationForm">
        <!-- Certificate Information -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">Certificate Information</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Calibration Number</label>
                    <input type="text" name="calibration_number" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Measure Type</label>
                    <select class="form-control" id="measure_type" name="measure_type" required>
                        <option value="">-- Choose Measure --</option>
                        <option value="T1">T1</option>
                        <option value="T2">T2</option>
                        <option value="T3">T3</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Calibration Name</label>
                    <select class="form-control" id="calibration_name" name="calibration_name" required>
                        <option value="">-- Choose Calibration Name --</option>
                        <option value="Micropipette">Micropipette</option>
                        <option value="Macropipette">Macropipette</option>
                        <option value="Multipette">Multipette</option>
                        <option value="Dispenser">Dispenser</option>
                        <option value="MultiChannel">MultiChannel</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Manufacturer</label>
                    <input type="text" name="manufacturer" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Serial Number</label>
                    <input type="text" name="serial_number" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Pipette Type</label>
                    <input type="text" name="pipette_type" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Volume Range</label>
                    <input type="text" name="volume_range" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Resolution</label>
                    <input type="text" name="resolution" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Unit</label>
                    <select class="form-control" id="unit" name="unit" required>
                        <option value="">-- Choose Unit --</option>
                        <option value="Ml">Ml</option>
                        <option value="µL">µL</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Owner Information -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">Owner Information & Standart Identity</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Name Owner</label>
                    <input type="text" name="name_owner" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Address Owner</label>
                    <input type="text" name="address_owner" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Traceability</label>
                    <input type="text" name="traceability" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Acceptance Date</label>
                    <input type="date" name="acceptance_date" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Calibration Date</label>
                    <input type="date" name="calibration_date" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Issue Date</label>
                    <input type="date" name="issued_date" class="form-control" required>
                </div>
            </div>
        </div>

        <!-- Calibration Environment -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">Calibration Environment</div>
            <div class="card-body row g-3">
                <div class="col-md-3">
                    <label>Temperature 1 (°C)</label>
                    <input type="number" step="any" name="environment_temp1" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Temperature 2 (°C)</label>
                    <input type="number" step="any" name="environment_temp2" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Air Pressure 1 (mbar)</label>
                    <input type="number" step="any" name="air_pressure1" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Air Pressure 2 (mbar)</label>
                    <input type="number" step="any" name="air_pressure2" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Humidity 1 (%)</label>
                    <input type="number" step="any" name="environment_humidity1" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Humidity 2 (%)</label>
                    <input type="number" step="any" name="environment_humidity2" class="form-control">
                </div>
            </div>
        </div>

        <!-- Channels -->
        <div class="card mb-4">
            <div class="card-header bg-warning">Channels Configuration</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Default Volumes (comma separated)</label>
                    <input type="text" id="defaultVolumes" class="form-control" placeholder="e.g. 10,100,1000">
                    <small class="text-muted">Pisahkan dengan koma — misal: 10, 100, 1000</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Number of Channels</label>
                    <input type="number" id="channelCount" min="1" max="12" value="3" class="form-control"
                        style="width: 150px;">
                    <button type="button" class="btn btn-secondary mt-2" id="generateChannels">Generate
                        Channels</button>
                </div>

                <div id="channelsContainer"></div>

                <!-- Uncertainty dan Status (1x saja untuk semua channel) -->
                <div class="mt-4">
                    <h5>Overall Calibration Info</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label>Uncertainty (µL)</label>
                            <input type="number" step="any" name="uncertainty" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label>Status</label>
                            <select class="form-control" id="status" name="status" required>
                                <option value="">-- Choose Status --</option>
                                <option value="OK">OK</option>
                                <option value="NOK">NOT OK</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group text-right">
            <a href="/pipette" class="btn btn-secondary">Batal</a>
            <button type="submit" id="submitBtn" class="btn btn-primary">Save Calibration Data</button>
        </div>
    </form>
</div>

<%- include('layout/footer') %>
<script>
    document.getElementById('generateChannels').addEventListener('click', () => {
        const container = document.getElementById('channelsContainer');
        container.innerHTML = "";

        const total = parseInt(document.getElementById('channelCount').value);
        const defaultVolumesInput = document.getElementById('defaultVolumes').value;
        const defaultVolumes = defaultVolumesInput
            .split(',')
            .map(v => v.trim())
            .filter(v => v !== "");

        for (let i = 1; i <= total; i++) {
            addChannelBlock(i, defaultVolumes);
        }
    });


    function addChannelBlock(i, volumes = []) {
        const container = document.getElementById('channelsContainer');
        const block = document.createElement('div');
        block.classList.add('channel-block', 'mb-3', 'p-3', 'border', 'rounded');
        block.setAttribute('data-channel', i);

        // Buat baris volume otomatis
        let rows = '';
        if (volumes.length > 0) {
            volumes.forEach((v, idx) => {
                rows += `
                <tr>
                    <td><input type="text" step="any" name="channels[${i}][results][${idx}][volume]" class="form-control" value="${v}" required></td>
                    <td><input type="text" step="any" name="channels[${i}][results][${idx}][correction]" class="form-control"></td>
                    <td><button type="button" class="btn btn-danger btn-sm removeVolume">×</button></td>
                </tr>`;
            });
        } else {
            // kalau user belum isi default volume, buat 1 kosong aja
            rows = `
            <tr>
                <td><input type="text" step="any" name="channels[${i}][results][0][volume]" class="form-control" required></td>
                <td><input type="text" step="any" name="channels[${i}][results][0][correction]" class="form-control"></td>
                <td><button type="button" class="btn btn-danger btn-sm removeVolume">×</button></td>
            </tr>`;
        }

        block.innerHTML = `
            <h5>Channel ${i} 
                <button type="button" class="btn btn-danger btn-sm btn-delete-channel">Delete Channel</button>
            </h5>
            <table class="table table-bordered volume-table" data-channel="${i}">
                <thead class="table-light">
                    <tr>
                        <th>Volume (µL)</th>
                        <th>Correction (µL)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
            <button type="button" class="btn btn-outline-primary btn-sm addVolume" data-channel="${i}" style="margin-bottom: 20px ">+ Add Volume</button>
        `;

        container.appendChild(block);
    }

    document.addEventListener('click', (e) => {
        // Tambah volume baru
        if (e.target.classList.contains('addVolume')) {
            const ch = e.target.dataset.channel;
            const tbody = document.querySelector(`.volume-table[data-channel="${ch}"] tbody`);
            const idx = tbody.querySelectorAll('tr').length;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><input type="text" step="any" name="channels[${ch}][results][${idx}][volume]" class="form-control" required></td>
                <td><input type="text" step="any" name="channels[${ch}][results][${idx}][correction]" class="form-control" required></td>
                <td><button type="button" class="btn btn-danger btn-sm removeVolume">×</button></td>
            `;
            tbody.appendChild(tr);
        }

        // Hapus volume
        if (e.target.classList.contains('removeVolume')) {
            e.target.closest('tr').remove();
        }

        // Hapus channel
        if (e.target.classList.contains('btn-delete-channel')) {
            const block = e.target.closest('.channel-block');
            block.remove();
            reindexChannels();
        }
    });

    // 🔁 Reindex semua channel setelah delete
    function reindexChannels() {
        const blocks = document.querySelectorAll('.channel-block');
        blocks.forEach((block, index) => {
            const newIndex = index + 1;
            block.setAttribute('data-channel', newIndex);

            const title = block.querySelector('h5');
            title.childNodes[0].textContent = `Channel ${newIndex} `; // ✅ tidak menghapus tombol delete

            const table = block.querySelector('.volume-table');
            table.setAttribute('data-channel', newIndex);

            const addButton = block.querySelector('.addVolume');
            addButton.setAttribute('data-channel', newIndex);

            const rows = table.querySelectorAll('tbody tr');
            rows.forEach((row, rIndex) => {
                const inputs = row.querySelectorAll('input');
                inputs[0].name = `channels[${newIndex}][results][${rIndex}][volume]`;
                inputs[1].name = `channels[${newIndex}][results][${rIndex}][correction]`;
            });
        });
    }

</script>