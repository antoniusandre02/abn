<script src="/socket.io/socket.io.js"></script>
<script>
    let currentPagePicked = 1;
    let currentPagePacked = 1;
    let currentPageShipped = 1;

    let totalPagesPicked = 1;
    let totalPagesPacked = 1;
    let totalPagesShipped = 1;

    let isSocketUpdateInProgress = false;
    let initialDataLoaded = false;

    function updateTable(tableId, data) {
        const tbody = document.querySelector(`#${tableId} tbody`);
        tbody.innerHTML = '';

        if (data.length === 0) {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td colspan="3" class="text-center text-muted">No data available</td>`;
            tbody.appendChild(tr);
        } else {
            data.forEach(item => {
                const tr = document.createElement('tr');
                tr.classList.add('align-middle');
                tr.innerHTML = `
                    <td>${item.sales_order_number} / ${item.delivery_order_number}</td>
                    <td>${item.location_warehouse}</td>
                    <td>${item.customer_name}</td>
                `;
                tbody.appendChild(tr);
            });
        }
    }

    function updatePaginationUI() {
        document.getElementById('currentPagePicked').textContent = `Picked Page ${currentPagePicked}`;
        document.getElementById('currentPagePacked').textContent = `Packed Page ${currentPagePacked}`;
        document.getElementById('currentPageShipped').textContent = `Shipped Page ${currentPageShipped}`;
    }

    function paginateStatus() {
        if (!initialDataLoaded || isSocketUpdateInProgress) {
            isSocketUpdateInProgress = false;
            return;
        }

        const url = `/dashboardData?pagePicked=${currentPagePicked}&pagePacked=${currentPagePacked}&pageShipped=${currentPageShipped}`;
        console.log("Fetching:", url);
        fetch(url)
        .then(res => res.json())
            .then(data => {
                totalPagesPicked = Math.ceil(data.pickedTotal / 10);
                totalPagesPacked = Math.ceil(data.packedTotal / 10);
                totalPagesShipped = Math.ceil(data.shippedTotal / 10);

                console.log('Auto-paginate total pages =>', totalPagesPicked, totalPagesPacked, totalPagesShipped);
                console.log(`📦 Fetching Picked ${currentPagePicked}, Packed ${currentPagePacked}, Shipped ${currentPageShipped}`);

                // Update Table
                updateTable('tbl_picked', data.pickedData);
                updateTable('tbl_packed', data.packedData);
                updateTable('tbl_shipped', data.shippedData);

                // Update UI before incrementing
                updatePaginationUI();

                // Increment pages after displaying
                currentPagePicked = totalPagesPicked > 1 && currentPagePicked < totalPagesPicked ? currentPagePicked + 1 : 1;
                currentPagePacked = totalPagesPacked > 1 && currentPagePacked < totalPagesPacked ? currentPagePacked + 1 : 1;
                currentPageShipped = totalPagesShipped > 1 && currentPageShipped < totalPagesShipped ? currentPageShipped + 1 : 1;

                document.getElementById('loading-indicator').style.display = 'block';
                setTimeout(() => {
                    document.getElementById('loading-indicator').style.display = 'none';
                }, 1000);
            })
            .catch(err => {
                console.error('Pagination fetch error:', err);
            });
    }

    const socket = io();
    socket.on('dataUpdate', (data) => {
        isSocketUpdateInProgress = true;
        initialDataLoaded = true;

        updateTable('tbl_picked', data.pickedData);
        updateTable('tbl_packed', data.packedData);
        updateTable('tbl_shipped', data.shippedData);

        currentPagePicked = 1;
        currentPagePacked = 1;
        currentPageShipped = 1;

        updatePaginationUI();
    });

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            initialDataLoaded = true;
        }, 1000);

        setInterval(paginateStatus, 20000);

        const hariNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        const bulanNames = ["January", "February", "March", "April", "May", "June", "July", "August",
            "September", "October", "November", "December"];
        const today = new Date();
        const hari = hariNames[today.getDay()];
        const tanggal = today.getDate();
        const bulan = bulanNames[today.getMonth()];
        const tahun = today.getFullYear();

        const suffix = (tanggal) => {
            if (tanggal % 10 === 1 && tanggal % 100 !== 11) return 'st';
            if (tanggal % 10 === 2 && tanggal % 100 !== 12) return 'nd';
            if (tanggal % 10 === 3 && tanggal % 100 !== 13) return 'rd';
            return 'th';
        };

        const formattedDate = `${hari}, ${bulan} ${tanggal}${suffix(tanggal)} ${tahun}`;
        document.getElementById('tanggal').textContent = formattedDate;
    });
</script>