<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  .card {
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    border: none;
    background-color: #fff;
    margin-bottom: 20px;
  }

  .card-header {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
    padding: 1rem;
    text-align: center;
    font-weight: 600;
    font-size: 1.1rem;
    color: #222;
    border-radius: 10px 10px 0 0;
  }

  .card-body {
    padding: 1rem;
  }

  .table {
    font-size: 0.95rem;
    color: #222;
  }

  .table th {
    background-color: #f0f0f0;
    font-weight: 600;
    border-bottom: 1px solid #dcdcdc;
  }

  .table td {
    vertical-align: middle;
    padding: 0.5rem;
  }

  .table thead th {
  background-color: #ffffff !important; 
  color: #000 !important;               
  border-bottom: 1px solid #dee2e6;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: #000;              
  }

  .table-striped tbody tr:nth-of-type(even) {
    background-color: #ffffff;       
  }

  .align-middle {
    vertical-align: middle !important;
  }

  .text-neutral {
    color: #333;
    font-weight: 600;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .content-wrapper {
    flex: 1;
    padding: 20px;
    background-color: #f4f6f9;
  }

  .content-header h3 {
    font-weight: 700;
    color: #111;
    margin-bottom: 0.5rem;
  }

  #tanggal {
    font-size: 1rem;
    color: #555;
    font-weight: 500;
  }

  .app-content-footer {
    font-size: 0.9rem;
    color: #777;
  }

  .pagination {
    text-align: center;
    margin: 10px;
    font-size: 20px;
  }

  .pagination a,
  .pagination span {
    display: inline-block;
    margin: 0 4px;
    color: #3490dc;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    border-radius: 5px;
  }

  .pagination .disabled {
    color: #999;
    cursor: default;
  }

  #loading-indicator {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #fff;
    padding: 10px 20px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    font-weight: 600;
    z-index: 1000;
  }

  @media (max-width: 768px) {
    .card {
      margin-bottom: 30px;
      /* Tambahkan jarak lebih pada layar kecil */
    }
  }

  .clamp-2-lines {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 2.8em;
  }
</style>

