<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Form Alasan - Abadi Nusa</title>
    <style>
        body {
            background-color: #cbd0d8;
            font-family: Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
        }

        .login-container {
            background-color: #fff;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 600px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        textarea {
            width: 100%;
            height: 200px;
            padding: 0.75rem;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 1rem;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 0.75rem;
            font-size: 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background-color: #007bff;
            color: white;
        }

        .logo-container {
            text-align: center;
            padding: 10px;
            margin-bottom: 20px;
        }

        .logo-container img {
            max-width: 50%;
            height: auto;
        }
    </style>
</head>

<body>
    <div class="login-container">
        <div class="logo-container">
            <img src="/adminlte/dist/img/logoabn.png" alt="Logo Abadi Nusa" />
        </div>
        <form action="/pengajuanMemo/reject/<%= id_memo %>?token=<%= token %>" method="POST">
            <div class="form-group">
                <label for="alasan" class="form-label">Tuliskan Alasan Anda</label>
                <textarea id="alasan" name="alasan" placeholder="Tulis alasan di sini..."></textarea>
            </div>
            <button type="submit">Kirim Alasan</button>
        </form>
    </div>
</body>

</html>