<%- include('layout/header') %> <%- include('layout/sidebar') %>

<div class="content-wrapper p-3">
  <h3 style="text-align: center; margin-bottom: 30px">Detail SO / DO</h3>
  <%
    function formatDateInput(date) {
      if (!date) return '';
      const d = new Date(date);
      const y = d.getFullYear();
      const m = ('0' + (d.getMonth() + 1)).slice(-2);
      const da = ('0' + d.getDate()).slice(-2);
      return `${y}-${m}-${da}`;
    }
  %>
  <form action="/soDo/update/<%= item.id %>" method="POST">
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Warehouse Location</label>
          <input
            type="text"
            class="form-control"
            name="warehouse_location"
            value="<%= item.location_warehouse%>"
            disabled
          />
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Sales Order Number</label>
          <input
            type="text"
            class="form-control"
            name="sales_order_number"
            value="<%= item.sales_order_number %>"
            disabled
          />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Sales Order Date</label>
          <input type="date" class="form-control" name="sales_order_date"
            value="<%= formatDateInput(item.sales_order_date) %>" readonly>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Delivery Order Number</label>
          <input
            type="text"
            class="form-control"
            name="delivery_order_number"
            value="<%= item.delivery_order_number %>"
            disabled
          />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label class="d-block mb-2">Delivery Order Barcode</label>
          <% if (item.barcode_do) { %>
          <div>
            <img
              src="data:image/png;base64,<%= item.barcode_do %>"
              alt="Barcode DO"
              style="width: 180px; height: 60px"
            />
          </div>
          <% } else { %>
          <p class="text-muted">Barcode belum tersedia</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Delivery Order Date</label>
          <input type="date" class="form-control" name="delivery_order_date"
            value="<%= formatDateInput(item.delivery_order_date) %>" readonly>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Customer Name</label>
          <input
            type="text"
            class="form-control"
            name="customer_name"
            value="<%= item.customer_name %>"
            disabled
          />
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Division</label>
          <input
            type="text"
            class="form-control"
            name="name_division"
            value="<%= item.name_division %>"
            disabled
          />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Ship By</label>
          <input
            type="text"
            class="form-control"
            name="ship_by"
            value="<%= item.ship_by %>"
            disabled
          />
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Resi Number</label>
          <input
            type="text"
            class="form-control"
            name="resi_number"
            value="<%= item.resi_number %>"
            disabled
          />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Weight (Kg)</label>
          <input
            type="text"
            class="form-control"
            name="weight"
            value="<%= item.weight %>"
            disabled
          />
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Shipping Price (Rp)</label>
          <input
            type="text"
            class="form-control"
            name="price"
            value="<%= item.price %>"
            disabled
          />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Pickup Date</label>
          <input type="date" class="form-control" name="eta" value="<%= formatDateInput(item.eta) %>" readonly>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>Nama Penerima</label>
          <input
            type="text"
            class="form-control"
            name="receive_name"
            value="<%= item.receive_name %>"
            placeholder="Saat ini belum tersedia, kemungkinan belum sampai."
            disabled
          />
        </div>
      </div>
    </div>
    <div class="form-group">
      <label>Order Number</label>
      <input type="text" class="form-control" id="order_number" name="order_number"
        value="<%= item.order_number %>" readonly>
    </div>
      <div class="form-group">
      <label>Info ke Invoicing Diterima</label>
      <input type="date" class="form-control" id="invoicingDate" name="invoicing_date"
        value="<%= formatDateInput(item.invoicing_date) %>" readonly>
    </div>
      <div class="form-group">
        <label>Notes</label>
        <input
          type="text"
          class="form-control"
          id="ekspedisi_note"
          name="ekspedisi_note"
          value="<%= item.ekspedisi_note%>"
          disabled
        />
      </div>
      <!-- Garis Pemisah dan Judul -->
    <hr class="my-4">
    <h3 class="text font-weight-bold mb-3">Detail Items</h3>
    <h5 class="text font-weight-bold mb-3">Non-Sparepart & Non-Consumable</h5>
    <!-- Tabel detail -->
    <div class="mt-3 card">
        <div class="card-body p-2">
            <table class="table table-bordered" id="addedItemsTable">
                <thead>
                    <tr>
                        <th>No Catalog</th>
                        <th>Serial Number</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Keterangan</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                  <% details.forEach((d, i) => { %>
                  <tr data-index="<%= i %>">
                    <td style="width: 15%;">
                      <input type="hidden" name="id_detail_monitoring_data" value="<%= d.id_detail_monitoring_data %>"/>
                      <input type="text" class="form-control" 
                            value="<%= d.no_catalog %>" 
                            <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %> />
                    </td>

                    <td style="width: 15%;">
                      <input type="text" class="form-control" 
                            value="<%= d.serial_number %>" 
                            <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %> />
                    </td>

                    <td style="width: 40%;">
                      <input type="text" class="form-control" 
                            value="<%= d.product_name %>" 
                            <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %> />
                    </td>

                    <td style="width: 15%;">
                      <% if (d.claimed_count && d.claimed_count >= d.qty_product) { %>
                        <input type="number" class="form-control" 
                              value="<%= d.qty_product %>" 
                              disabled />
                        <small class="text-danger d-block mt-1">Semua sudah klaim</small>
                      <% } else { %>
                        <input type="number" class="form-control" 
                              value="<%= d.qty_product %>" 
                              min="<%= d.claimed_count || 0 %>" />
                        <% if (d.claimed_count > 0) { %>
                          <small class="text-muted d-block mt-1">
                            Sudah Claim: <%= d.claimed_count %> | Sisa <strong> <%= d.qty_product - d.claimed_count %> </strong> Barcode yang tersedia.
                          </small>
                        <% } %>
                      <% } %>
                    </td>


                    <td style="width: 20%;">
                      <select class="form-control" name="detail_keterangan[]"
                              <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %>>
                        <option value="Pcs"  <%= d.keterangan === 'Pcs' ? 'selected' : '' %>>Pcs</option>
                        <option value="Pack" <%= d.keterangan === 'Pack' ? 'selected' : '' %>>Pack</option>
                        <option value="Unit" <%= d.keterangan === 'Unit' ? 'selected' : '' %>>Unit</option>
                      </select>
                    </td>

                    <td style="width: 10%; text-align: center; vertical-align: middle;">
                      <a href="/soDo/get-barcode-ewarranty/<%= d.id_detail_monitoring_data %>">
                        <button type="button" class="btn btn-warning btn-sm btn-qrcode"
                              style="text-align: center;" title="Kelola Barcode E-Warranty"
                              <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %>>
                          <i class="fa fa-qrcode" aria-hidden="true"></i>
                        </button>
                      </a>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>

            </table>
        </div>
    </div>
    <hr class="my-4">
      <div class="form-group text-right">
        <a href="/soDo" class="btn btn-primary">Kembali</a>
      </div>
    </div>
  </form>
</div>

<%- include('layout/footer') %>