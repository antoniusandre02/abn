<%- include('layout/header') %>
<%- include('layout/sidebar') %>
<style>
    .table .th {
      word-wrap:break-word
    }
</style>
<div class="content-wrapper">
    <% if (successMessage && successMessage.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= errorMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>
    <div class="row">
        <div class="col-12">
            <section class="content p-3">
                <div class="content-header">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-sm-6">
                                <h3>Pippete Calibration</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="form-inline row g-2 ms">
                            <!-- <form> -->
                            <div class="col-auto">
                                <input type="text" id="search" name="search" class="form-control form-control-sm"
                                    placeholder="Cari Pipette Calibration">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateStart" name="filterDateStart"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateEnd" name="filterDateEnd"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <button id="filterButton" name="filterButton"
                                    class="btn btn-sm btn-primary">Filter</button>
                                <button id="resetButton" name="resetButton"
                                    class="btn btn-sm btn-secondary">Reset</button>
                            </div>
                            <!-- </form> -->
                        </div>
                    </div>
                    <!---end card-header -->
                    
                    <!-- Table Content -->
                    <div class="card-body table-responsive">
                        <table id="assetTable" class="table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr style="text-align: center;">
                                    <th style="font-size: 14px; width: 40px;">No</th>
                                    <th style="font-size: 14px; width: 200px;">Certificate Calibration Number</th>
                                    <th style="font-size: 14px; width: 150px;">Name Owner</th>
                                    <th style="font-size: 14px; width: 200px;">Measure Name</th>
                                    <th style="font-size: 14px; width: 120px;">Pipette Type</th>
                                    <th style="font-size: 14px; width: 200px;">Calibration Date / Issued Date</th>
                                    <th style="font-size: 14px; width: 150px;" class="text-center">Action</th>
                                </tr>
                                </thead>
                            <% if (data && data.length > 0) { %>
                            <% data.forEach((item, index) => { %>
                            <tbody id="searchResults">
                                <tr>
                                    <td style="font-size: 15px; justify-content: center; vertical-align: middle;" class="text-center pl-2">
                                        <%= index + 1 %>
                                    </td>
                                    <td style="font-size: 15px; vertical-align: middle; font-weight: bold;">
                                        <% if (item.certificate_number) { %>
                                            <%= item.certificate_number %>
                                        <% } else { %>
                                            <span class="badge badge-danger text-wrap">Pipette Calibration belum di Approve</span>
                                        <% } %>
                                    </td>
                                    <td style="font-size: 15px; vertical-align: middle;"><%= item.name_owner %></td>
                                    <td style="font-size: 15px; vertical-align: middle;"><%= item.measure_name %></td>
                                    <td style="font-size: 15px; vertical-align: middle;"><%= item.pipette_type %></td>
                                    <td class="font-size: 15px; vertical-align: middle;">
                                        <%= new Date(item.calibration_date).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year: 'numeric'}).replace(/ /g, '-') %>
                                        / <br>
                                        <%= new Date(item.issued_date).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year: 'numeric'}).replace(/ /g, '-') %>
                                    </td>

                                    <td class="text-center pr-2" style="vertical-align: middle;">
                                        <div class="d-flex justify-content-center">
                                            <% if(role == 1 || role == 18) { %>
                                                <!-- Edit -->
                                                <a href="pipette/calibrationEdit/<%= item.id_certificate %>"
                                                class="btn btn-sm btn-warning me-2" style="margin-right: 5px;" title="Edit">
                                                <i class="fas fa-edit"></i>
                                                </a>
                                            
                                                <a href="pipette/calibrationView/<%= item.id_certificate %>"
                                                class="btn btn-sm btn-secondary me-2" style="margin-right: 5px;" title="View">
                                                <i class="fas fa-eye fa-inverse"></i>
                                                </a>
                                                <!-- Approve -->
                                                <% if (item.is_approved === false) { %>
                                                    <a href="pipette/approvePipetteView/<%= item.id_certificate %>"
                                                        class="btn btn-sm btn-success me-2" style="margin-right: 5px;" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </a>
                                                <% } else { %>
                                                    <button class="btn btn-sm btn-success me-2" style="margin-right: 5px;" title="Sudah di Approve" disabled>
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                <% } %>
                                            <% } else { %>
                                                <a href="pipette/calibrationView/<%= item.id_certificate %>"
                                                class="btn btn-sm btn-secondary me-2" style="margin-right: 5px;" title="View">
                                                <i class="fas fa-eye fa-inverse"></i>
                                            <% } %>

                                            <!-- Print -->
                                            <a href="/pipette/print/<%= item.id_certificate %>"
                                            class="btn btn-sm btn-primary" target="_blank" title="Cetak E-Calibration">
                                            <i class="fas fa-print fa-lg"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="11" class="text-center">Tidak ada data</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!---end Table Content-->
                    <div class="d-flex justify-content-center mt-3">
                        <% const pageLimit = 5; 
                            const startPage = Math.max(1, currentPage - Math.floor(pageLimit / 2));
                            const endPage = Math.min(totalPages, startPage + pageLimit - 1);
                            const queryString = `search=${encodeURIComponent(searchKeyword || '')}&filterDateStart=${filterDateStart || ''}&filterDateEnd=${filterDateEnd || ''}`;
                        %>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <% if (currentPage > 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=1&<%= queryString %>">&laquo; First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= queryString %>">Prev</a>
                                </li>
                                <% } %>

                                <% for (let i = startPage; i <= endPage; i++) { %>
                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>&<%= queryString %>"><%= i %></a>
                                </li>
                                <% } %>

                                <% if (currentPage < totalPages) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= queryString %>">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= totalPages %>&<%= queryString %>">Last
                                        &raquo;</a>
                                </li>
                                <% } %>
                            </ul>
                        </nav>
                    </div>
                    <br>
                    <!---END pagination-->
                </div>
                <!-- end Card Table -->
            </section>
        </div>
    </div>
</div>
<%- include('layout/footer') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<!-- Toast SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    <% if (toastSuccess && toastSuccess.length > 0) { %>
        Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: '<%= toastSuccess[0] %>',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true
        });
    <% } else if (toastError && toastError.length > 0) { %>
        Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: '<%= toastError[0] %>',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true
        });
    <% } %>
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('search');
        const startDate = document.getElementById('filterDateStart');
        const endDate = document.getElementById('filterDateEnd');
        const filterButton = document.getElementById('filterButton');
        const resetButton = document.getElementById('resetButton');

        // Fungsi handle filter
        function handleFilter() {
            const query = new URLSearchParams();

            if (searchInput.value.trim() !== '') {
                query.append('search', searchInput.value.trim());
            }
            if (startDate.value) {
                query.append('filterDateStart', startDate.value);
            }
            if (endDate.value) {
                query.append('filterDateEnd', endDate.value);
            }

            window.location.href = `/ewarranty?${query.toString()}`;
        }

        // Event tombol Filter
        filterButton.addEventListener('click', function (e) {
            e.preventDefault();
            handleFilter();
        });

        // Event tombol Reset
        resetButton.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = `/ewarranty`;
        });

        // Event Enter di input (search & tanggal)
        [searchInput, startDate, endDate].forEach(input => {
            input.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleFilter();
                }
            });
        });
    });
</script>