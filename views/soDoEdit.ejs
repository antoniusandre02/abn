<%- include('layout/header') %>
<%- include('layout/sidebar') %>

<div class="content-wrapper p-3">
  <h3 style="text-align: center; margin-bottom: 30px">Edit SO / DO</h3>
  <%
    function formatDateInput(date) {
      if (!date) return '';
      const d = new Date(date);
      const y = d.getFullYear();
      const m = ('0' + (d.getMonth() + 1)).slice(-2);
      const da = ('0' + d.getDate()).slice(-2);
      return `${y}-${m}-${da}`;
    }
  %>
  <form id="editForm" data-role="<%= user.role %>" data-id="<%= item.id_monitoring_data %>" action="/update/<%= item.id_monitoring_data %>" method="POST">
    <input type="hidden" value="<%= item.id_monitoring_data %>" >
    <input type="hidden" id="tempItems" name="tempItems">
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Warehouse Location</label>
          <% if (role == 8 || role == 10 || role == 11) { %>
          <input type="text" class="form-control"
            value="<%= optionWarehouseLocation.find(w => w.id_warehouse === item.warehouse_location)?.location_warehouse %>" readonly>
          <input type="hidden" name="warehouse_location" value="<%= item.warehouse_location %>">
          <input type="hidden" name="location_warehouse_name" value="<%= optionWarehouseLocation.find(w => w.id_warehouse === item.warehouse_location)?.location_warehouse %>">
          <% } else { %>
          <select name="warehouse_location" class="form-control">
            <% optionWarehouseLocation.forEach(warehouse => { %>
            <option value="<%= warehouse.id_warehouse %>" <%= warehouse.id_warehouse === item.warehouse_location ? 'selected' : '' %>>
              <%= warehouse.location_warehouse %>
            </option>
            <% }) %>
          </select>
          <% } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Sales Order Number</label>
          <input type="text" class="form-control" name="sales_order_number" placeholder= "Input Sales Order Number" value="<%= item.sales_order_number %>" <% if (role == 8 || role == 10 || role == 11 || (role == 12 && item.division_team != 3)) { %> readonly <% } %>>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Sales Order Date</label>
          <input type="date" class="form-control" name="sales_order_date"
            value="<%= formatDateInput(item.sales_order_date) %>" <% if (role == 8 || role == 10 || role == 11 || (role == 12 && item.division_team != 3)) { %> readonly <% } %>>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Delivery Order Number</label>
          <input type="text" class="form-control" name="delivery_order_number" placeholder= "Input Delivery Order Number" value="<%= item.delivery_order_number %>" <% if (role == 8 || role == 10 || role == 11 || (role == 12 && item.division_team != 3)) { %> readonly <% } %>>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label class="d-block mb-2">Delivery Order Barcode</label>
          <% if (item.barcode_do) { %>
          <div>
            <img
              src="data:image/png;base64,<%= item.barcode_do %>"
              alt="Barcode DO"
              style="width: 180px; height: 60px"
            />
          </div>
          <% } else { %>
          <p class="text-muted">Barcode belum tersedia</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Delivery Order Date</label>
          <input type="date" class="form-control" name="delivery_order_date"
            value="<%= formatDateInput(item.delivery_order_date) %>" <% if (role == 8 || role == 10 || role == 11 || (role == 12 && item.division_team != 3)) { %> readonly <% } %>>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Customer Name</label>
          <input type="text" class="form-control" name="customer_name" value="<%= item.customer_name %>" <% if (role == 8 || role == 10 || role == 11) { %> readonly <% } %>>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Division</label>
          <% if (role == 8 || role == 10 || role == 11) { %>
          <input type="text" class="form-control"
            value="<%= optionDivision.find(w => w.id_division === item.division_team)?.name_division%>" readonly>
          <input type="hidden" name="division_team" value="<%= item.division_team %>">
          <% } else { %>
          <select name="division_team" class="form-control">
            <% optionDivision.forEach(division => { %>
            <option value="<%= division.id_division%>" <%= division.id_division === item.division_team ? 'selected' : '' %>>
              <%= division.name_division%>
            </option>
            <% }) %>
          </select>
          <% } %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Ship By</label>
          <input type="text" class="form-control" name="ship_by" placeholder="Jika Tidak ada diisi - " value="<%= item.ship_by %>" <% if (role == 8) { %> readonly <% } %>>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Resi Number</label>
          <input type="text" class="form-control" name="resi_number" placeholder="Jika Tidak ada diisi - " value="<%= item.resi_number %>" <% if (role == 8) { %> readonly <% } %>>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Weight (Kg)</label>
          <input type="text" class="form-control" name="weight" placeholder="Jika Tidak ada diisi 0 " value="<%= item.weight %>" <% if (role == 8) { %> readonly <% } %>>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Shipping Price (Rp)</label>
          <input type="text" class="form-control" name="price" placeholder="Jika Tidak ada diisi 0 " value="<%= item.price %>" <% if (role == 8) { %> readonly <% } %>>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>Pickup Date</label>
          <input type="date" class="form-control" name="eta" value="<%= item.eta ? formatDateInput(item.eta) : '' %>" <% if (role == 8) { %> readonly <% } %>>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <label>Nama Penerima</label>
          <input type="text" class="form-control" name="receive_name" placeholder="Nama Penerima " value="<%= item.receive_name %>" <% if (role == 8) { %> readonly <% } %>>
          <p class="text-danger">*Wajib diisi ketika sudah diterima</p>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label>Notes</label>
      <input type="text" class="form-control" name="ekspedisi_note" placeholder="Catatan atau Keterangan" value="<%= item.ekspedisi_note %>" <% if (role == 8) { %> readonly <% } %>>
    </div>

    <% if (user && [1, 8, 10, 11, 12].includes(user.role)) { %>
    <div class="form-group">
      <label>Info ke Invoicing Diterima</label>
      <input type="date" class="form-control" id="invoicingDate" name="invoicing_date"
        value="<%= formatDateInput(item.invoicing_date) ? formatDateInput(item.invoicing_date) : '' %>" <% if ([10, 11, 12, 14].includes(user.role)) { %> readonly <% } %>>
    </div>
    <% } %>

    <% if (user && [1, 16, 10, 11, 12].includes(user.role)) { %>
    <div class="form-group">
      <label>Order Number</label>
      <input type="text" class="form-control" id="order_number" name="order_number"
        value="<%= item.order_number %>" <% if ([10, 11, 12, 14].includes(user.role)) { %> readonly <% } %>>
    </div>
    <% } %>
    <!-- Garis Pemisah dan Judul -->
    <hr class="my-4">
    <h5 class="text font-weight-bold mb-3">Non-Sparepart & Non-Consumable</h5>
    <div class="mt-0 ml-3 mr-3 mb-0 align-items-center">
      <div class="form-group row align-items-end " style="gap: 8px;">
          <div style="width: 15%;">
              <label>No Catalog</label>
              <input type="text" class="form-control" id="no_catalog" name="no_catalog" />
          </div>
          <div style="width: 15%;">
              <label>Serial Number</label>
              <input type="text" class="form-control" id="serial_number" name="serial_number" />
          </div>
          <div style="width: 23%;">
              <label>Description</label>
              <input type="text" class="form-control" id="product_name" name="product_name" />
          </div>
          <div style="width: 10%;">
              <label>Quantity</label>
              <input type="number" class="form-control" id="qty_product" name="qty_product" />
          </div>
          <div style="width: 20%;">
              <label for="keterangan">Keterangan</label>
              <select class="form-control" id="keterangan" name="keterangan">
                  <option value="">-- Pilih Keterangan --</option>
                  <option value="Pcs">Pcs</option>
                  <option value="Pack">Pack</option>
                  <option value="Unit">Unit</option>
              </select>
          </div>
          <div style="width: 10%;">
              <label class="invisible">Tambah</label>
              <button type="button" class="btn btn-success" id="btnAddDetailMonitoring">
                  Tambah
              </button>
          </div>
      </div>
    </div>
    <!-- Tabel detail -->
    <div class="mt-3 card">
        <div class="card-body p-2">
            <table class="table table-bordered" id="addedItemsTable">
                <thead>
                    <tr>
                        <th>No Catalog</th>
                        <th>Serial Number</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Keterangan</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% details.forEach((d, i) => { %>
                    <tr data-index="<%= i %>">
                        <td style="width: 20%;">
                          <input type="hidden" name="id_detail_monitoring_data" value="<%= d.id_detail_monitoring_data %>"/>
                          <input type="text" class="form-control" value="<%= d.no_catalog %>" />
                        </td>
                        <td style="width: 20%;"><input type="text" class="form-control" value="<%= d.serial_number %>" />
                        </td>
                        <td style="width: 40%;"><input type="text" class="form-control" value="<%= d.product_name %>" /></td>
                        <td style="width: 10%;">
                          <input type="number" class="form-control" 
                                value="<%= d.qty_product %>" 
                                min="<%= d.claimed_count || 0 %>"
                                <%= d.claimed_count >= d.qty_product ? 'disabled' : '' %> />
                          <% if (d.claimed_count > 0) { %>
                            <% if (d.claimed_count >= d.qty_product) { %>
                              <small class="text-danger">Semua sudah klaim, tidak bisa diubah</small>
                            <% } else { %>
                              <small class="text-muted">Minimal: <%= d.claimed_count %> (sudah klaim)</small>
                            <% } %>
                          <% } %>
                        </td>
                        <td style="width: 20%;">
                          <select class="form-control" name="detail_keterangan[]">
                            <option value="Pcs"  <%= d.keterangan === 'Pcs' ? 'selected' : '' %>>Pcs</option>
                            <option value="Pack" <%= d.keterangan === 'Pack' ? 'selected' : '' %>>Pack</option>
                            <option value="Unit" <%= d.keterangan === 'Unit' ? 'selected' : '' %>>Unit</option>
                          </select>
                        </td>
                        <td style="width: 10%; text-align: center; vertical-align: middle;"><button
                                type="button" class="btn btn-danger btn-sm btn-remove"
                                style="text-align: center;"><i class="fa fa-times"
                                    aria-hidden="true"></i></button></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <hr class="my-4">
    <div class="form-group text-right">
      <a href="/soDo" class="btn btn-secondary">Batal</a>
      <button type="submit" id="submitBtn" class="btn btn-primary">Simpan Perubahan</button>
    </div>
  </form>
</div>

<%- include('layout/footer') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function validateDateMin2020(fieldName, label) {
    const input = document.querySelector(`[name="${fieldName}"]`);
    if (!input) return true;

    const value = input.value.trim();
    if (!value) {
      Swal.fire('Error', `${label} wajib diisi!`, 'error');
      return false;
    }

    // ✅ pastikan format DD-MM-YYYY valid secara regex
    const validFormat = /^\d{4}-\d{2}-\d{2}$/;
    if (!validFormat.test(value)) {
      Swal.fire('Error', `${label} harus dalam format DD-MM-YYYY!`, 'error');
      return false;
    }

    const [year, month, day] = value.split('-').map(Number);
    if (year < 2020 || month < 1 || month > 12 || day < 1 || day > 31) {
      Swal.fire('Error', `${label} tidak valid!`, 'error');
      return false;
    }

    const d = new Date(value);
    if (isNaN(d.getTime())) {
      Swal.fire('Error', `${label} tidak dapat diproses!`, 'error');
      return false;
    }

    return true;
  }
  let tempItems = <%-JSON.stringify(details.map(d => ({
      id_detail_monitoring_data:  d.id_detail_monitoring_data,
      no_catalog: d.no_catalog,
      serial_number: d.serial_number,
      product_name: d.product_name,
      qty_product: d.qty_product,
      keterangan: d.keterangan,
      claimed_count: d.claimed_count // ✅ ditambahkan
  })))%>;

  function renderTable() {
    const tbody = $('#addedItemsTable tbody');
    tbody.empty();
    tempItems.forEach((item, index) => {
        let claimInfo = '';
        let qtyInput = '';
        let actionBtn = '';

        if (item.claimed_count && item.claimed_count >= item.qty_product) {
            qtyInput = `<input type="number" class="form-control" 
                                value="${item.qty_product}" disabled />`;
            claimInfo = `<small class="text-danger">Semua sudah klaim, tidak bisa diubah</small>`;
            actionBtn = `<button type="button" class="btn btn-secondary btn-sm" disabled>X</button>`;
        } else {
            qtyInput = `<input type="number" class="form-control" value="${item.qty_product}" min="${item.claimed_count || 0}" />`;
            if (item.claimed_count > 0) {
              const editable = item.qty_product - item.claimed_count;
              claimInfo = `<small class="text-muted">Sudah Claim: ${item.claimed_count} | Bisa diubah: ${editable} </small>`;
            }
            actionBtn = `<button type="button" class="btn btn-danger btn-sm btn-remove">X</button>`;
        }

        tbody.append(`
            <tr data-index="${index}">
                <td>
                  <!-- ✅ tambahkan hidden input dengan class id-detail -->
                  <input type="hidden" class="id-detail" value="${item.id_detail_monitoring_data || ''}" />
                  <input type="text" class="form-control" value="${item.no_catalog}" ${item.claimed_count >= item.qty_product ? 'disabled' : ''}/>
                </td>
                <td><input type="text" class="form-control" value="${item.serial_number}" ${item.claimed_count >= item.qty_product ? 'disabled' : ''}/></td>
                <td><input type="text" class="form-control" value="${item.product_name}" ${item.claimed_count >= item.qty_product ? 'disabled' : ''}/></td>
                <td>${qtyInput} ${claimInfo}</td>
                <td>
                  <select class="form-control" ${item.claimed_count >= item.qty_product ? 'disabled' : ''}>
                    <option value="Pcs"  ${item.keterangan === 'Pcs' ? 'selected' : ''}>Pcs</option>
                    <option value="Pack" ${item.keterangan === 'Pack' ? 'selected' : ''}>Pack</option>
                    <option value="Unit" ${item.keterangan === 'Unit' ? 'selected' : ''}>Unit</option>
                  </select>
                </td>
                <td>${actionBtn}</td>
            </tr>
        `);
    });
  }


  async function exportRowFinanceToPDF() {
    const { jsPDF } = window.jspdf;

    const doc = new jsPDF({
      orientation: 'landscape',
      unit: 'mm',
      format: [58, 29]
    });

    const formatDate = (str) => {
      if (!str || str === '-') return "-";
      const [year, month, day] = str.split('-');
      const date = new Date(`${year}-${month}-${day}`);
      if (isNaN(date)) return str;
      return date.toLocaleDateString('en-GB', {
        day: '2-digit', month: 'short', year: 'numeric'
      }).replace(/ /g, '-');
    };

    const getValue = (name) => document.querySelector(`[name="${name}"]`)?.value || '-';

    const doNumber = getValue('delivery_order_number');
    const customer = getValue('customer_name');
    const shipBy = getValue('ship_by');
    const receiveName = getValue('receive_name');
    const eta = getValue('eta');
    const invoicingDate = getValue('invoicing_date');
    const location = getValue('location_warehouse_name');

    // Outline
    doc.setLineWidth(0.3);
    doc.rect(2, 2, 54, 25);

    let xLeft = 5;
    let xRight = 53;
    let y = 5;

    doc.setFontSize(7);
    doc.setFont("helvetica", "bold");
    doc.text(doNumber, xLeft, y);
    doc.setFont("helvetica", "normal");
    doc.text(formatDate(eta), xRight, y, { align: "right" });

    y += 5;
    doc.text(customer, xLeft, y);

    y += 5;
    doc.text(shipBy || "-", xLeft, y);

    y += 5;
    doc.text(receiveName, xLeft, y);

    y += 6;
    doc.setFont("helvetica", "italic");
    doc.setFontSize(7);
    doc.text(`INFO dr GUDANG ${location} Tgl.`, xLeft, y);
    doc.text(formatDate(invoicingDate), xRight, y, { align: "right" });

    doc.save(`finance-label-${doNumber}.pdf`);
  }

  document.addEventListener('DOMContentLoaded', function() {
    renderTable();

    // Notifikasi dari query param
    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get('status');
    const msg = urlParams.get('msg');
    if (status && msg) {
      Swal.fire({
          toast: true,
          position: 'top-end',
          icon: status,
          title: msg,
          showConfirmButton: false,
          timer: 3000,
          timerProgressBar: true
      });
    }

    // Tambah item detail
    $('#btnAddDetailMonitoring').on('click', () => {
        const no_catalog = $('#no_catalog').val().trim();
        const serial_number = $('#serial_number').val().trim();
        const product_name = $('#product_name').val().trim();
        const qty_product = $('#qty_product').val().trim();
        const keterangan = $('#keterangan').val();

        if (!no_catalog && !serial_number || !product_name || !qty_product || !keterangan) {
          Swal.fire({
            icon: 'warning',
            title: 'Lengkapi semua field detail!',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2500
          });
          return;
        }
        tempItems.push({no_catalog, serial_number, product_name, qty_product, keterangan });
        renderTable();
        $('#no_catalog, #serial_number, #product_name, #qty_product').val('');
        $('#keterangan').val('');
    });

    // Hapus row
    $('#addedItemsTable').on('click', '.btn-remove', function () {
        const index = $(this).closest('tr').data('index');
        tempItems.splice(index, 1);
        renderTable();
    });

    // Submit form
    $('#editForm').on('submit', async function (e) {
      // ✅ validasi dulu sebelum jalan
      if (!validateDateMin2020("sales_order_date", "Sales Order Date")) {
        e.preventDefault();
        return;
      }
      if (!validateDateMin2020("delivery_order_date", "Delivery Order Date")) {
        e.preventDefault();
        return;
      }

        const rows = $('#addedItemsTable tbody tr');
        tempItems = [];

        rows.each(function () {
          // ambil semua input di cell pertama (No Catalog)
          const noCatalogCell = $(this).find('td:eq(0)');
          const id_detail_monitoring_data = noCatalogCell.find('input.id-detail').val(); // hidden
          const no_catalog = noCatalogCell.find('input[type=text]').val().trim();       // text box

          const serial_number = $(this).find('td:eq(1) input').val().trim();
          const product_name = $(this).find('td:eq(2) input').val().trim();
          const qty_product = $(this).find('td:eq(3) input').val().trim();
          const keterangan = $(this).find('td:eq(4) select').val();

          if (no_catalog || serial_number) {
              tempItems.push({
                  id_detail_monitoring_data: id_detail_monitoring_data && id_detail_monitoring_data !== "undefined" && id_detail_monitoring_data !== "" ? id_detail_monitoring_data : null,
                  no_catalog,
                  serial_number,
                  product_name,
                  qty_product,
                  keterangan
              });
          }
      });


        if (tempItems.length === 0) {
            e.preventDefault();
            Swal.fire({
              icon: 'warning',
              title: 'Nomor Catalog Wajib diisi!',
              toast: true,
              position: 'top-end',
              showConfirmButton: false,
              timer: 2500
            });
            return;
        }

        $('#tempItems').val(JSON.stringify(tempItems));

        const role = parseInt(this.dataset.role);
        if (role === 8) {
          e.preventDefault();

          const formData = new FormData(this);
          const data = new URLSearchParams();
          for (const pair of formData) {
            data.append(pair[0], pair[1]);
          }

          try {
            const response = await fetch(this.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: data
            });

            if (response.ok) {
              await exportRowFinanceToPDF();
              window.location.href = "/soDo";
            } else {
              alert("Gagal menyimpan perubahan.");
            }
          } catch (err) {
            console.error(err);
            alert("Terjadi kesalahan.");
          }
        }
    });
  });
</script>