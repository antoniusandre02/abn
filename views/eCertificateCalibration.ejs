<%- include('layout/header') %>
<%- include('layout/sidebar') %>
<div class="content-wrapper">
    <% if (successMessage && successMessage.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= errorMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>
    <div class="row">
        <div class="col-12">
            <section class="content p-3">
                <div class="content-header">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-sm-6">
                                <h3>E-Certificate</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="form-inline row g-2 ms">
                            <!-- <form> -->
                            <div class="col-auto">
                                <input type="text" id="search" name="search" class="form-control form-control-sm"
                                    placeholder="Cari Certificate">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateStart" name="filterDateStart"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <input type="date" id="filterDateEnd" name="filterDateEnd"
                                    class="form-control form-control-sm">
                            </div>
                            <div class="col-auto">
                                <button id="filterButton" name="filterButton"
                                    class="btn btn-sm btn-primary">Filter</button>
                                <button id="resetButton" name="resetButton"
                                    class="btn btn-sm btn-secondary">Reset</button>
                            </div>
                            <!-- </form> -->
                        </div>
                    </div>
                    <!---end card-header -->
                    <!-- Table Content -->
                    <div class="card-body table-responsive">
                        <table id="assetTable" class="table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr style="text-align: center;">
                                    <th style="font-size: 14px" class="text-center pl-2">No</th>
                                    <th style="font-size: 14px">Customer Name</th>
                                    <th style="font-size: 14px">Company Name</th>
                                    <th style="font-size: 14px">Product Name</th>
                                    <th style="font-size: 14px">Product Type</th>
                                    <th style="font-size: 14px">Installation Date / Date Received</th>
                                    <th style="font-size: 14px" class="text-center pl-2 pr-2" colspan="2">Status </th>
                                </tr>
                            </thead>
                            <% if (data && data.length > 0) { %>
                            <% data.forEach((item, index) => { %>
                            <tbody id="searchResults">
                                <tr>
                                    <td style="font-size: 15px; justify-content: center;" class="text-center pl-2">
                                        <%= index + 1 %>
                                    </td>
                                    <td style="font-size: 15px;"><%= item.kode_asset %></td>
                                    <td style="font-size: 15px"><%= item.nama_asset %></td>
                                    <td style="font-size: 15px"><%= item.sn_asset %></td>
                                    <td style="font-size: 15px">
                                        <a href="/barcodeAsset/<%= item.kode_asset %>" target="_blank"
                                            class="btn btn-block btn-info btn-sm">
                                            Cetak Barcode
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <% let badgeClass = ''; %>
                                        <% if (item.status_asset === 'TERSEDIA') { %>
                                        <% badgeClass = 'badge-success'; %>
                                        <% } else if (item.status_asset === 'DIPINJAM') { %>
                                        <% badgeClass = 'badge-primary'; %>
                                        <% } else if (item.status_asset === 'RUSAK') { %>
                                        <% badgeClass = 'badge-warning'; %>
                                        <% } else if (item.status_asset === 'HILANG') { %>
                                        <% badgeClass = 'badge-secondary'; %>
                                        <% } else if (item.status_asset === 'DIJUAL') { %>
                                        <% badgeClass = 'badge-danger'; %>
                                        <% } else { %>
                                        <% badgeClass = 'badge-light'; %>
                                        <% } %>
                                        <span class="p-2 badge <%= badgeClass %>" style="width: 100px; height: 30px;"><%= item.status_asset %></span>
                                    </td>

                                    <td class="text-center pr-2">
                                        <a href="/assetEdit/<%= item.id_asset %>" class="btn btn-sm btn-warning"
                                            title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="11" class="text-center">Tidak ada data</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!---end Table Content-->
                    <div class="d-flex justify-content-center mt-3">
                        <% const pageLimit = 5; 
                            const startPage = Math.max(1, currentPage - Math.floor(pageLimit / 2));
                            const endPage = Math.min(totalPages, startPage + pageLimit - 1);
                            const queryString = `search=${encodeURIComponent(searchKeyword || '')}&filterDateStart=${filterDateStart || ''}&filterDateEnd=${filterDateEnd || ''}`;
                        %>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                            <% if (currentPage > 1) { %>
                                <li class="page-item">
                                <a class="page-link" href="?page=1&<%= queryString %>">&laquo; First</a>
                                </li>
                                <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= queryString %>">Prev</a>
                                </li>
                            <% } %>

                            <% for (let i = startPage; i <= endPage; i++) { %>
                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>&<%= queryString %>"><%= i %></a>
                                </li>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                                <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= queryString %>">Next</a>
                                </li>
                                <li class="page-item">
                                <a class="page-link" href="?page=<%= totalPages %>&<%= queryString %>">Last &raquo;</a>
                                </li>
                            <% } %>
                            </ul>
                        </nav>
                    </div>
                    <br>
                    <!---END pagination-->
                </div>
                <!-- end Card Table -->
            </section>
        </div>
    </div>
</div>
<%- include('layout/footer') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
