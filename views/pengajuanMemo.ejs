<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<%- include('layout/header') %>
<%- include('layout/sidebar') %>
<div class="content-wrapper">
    <% if (successMessage && successMessage.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= errorMessage %>
        <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
            &times;
        </button>
    </div>
    <% } %>
    <div class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3>Daftar Pengajuan Memo</h3>
                </div>
                <div class="col-sm-6">
                    <div class="mb-2 text-right">
                        <button type="button" class="btn btn-primary" style="width: 200px;" data-toggle="modal"
                            data-target="#modal-lg">
                            Pengajuan Memo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="form-inline row g-2 ms">
                    <!-- <form> -->
                    <div class="col-auto">
                        <input type="text" id="search" name="search" class="form-control form-control-sm"
                            placeholder="Cari Memo">
                    </div>
                    <div class="col-auto">
                        <input type="date" id="filterDateStart" name="filterDateStart"
                            class="form-control form-control-sm">
                    </div>
                    /
                    <div class="col-auto">
                        <input type="date" id="filterDateEnd" name="filterDateEnd" class="form-control form-control-sm">
                    </div>
                    <div class="col-auto">
                        <button id="filterButton" name="filterButton" class="btn btn-sm btn-primary">Filter</button>
                        <button id="resetButton" name="resetButton" class="btn btn-sm btn-secondary">Reset</button>
                    </div>
                    <!-- </form> -->
                </div>
            </div>
            <!---end card-header -->
            <!-- Table Content -->
            <div class="card-body table-responsive">
                <table id="assetTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr style="text-align: center; ">
                            <th style="font-size: 14px; vertical-align: middle;" class="text-center pl-2">No</th>
                            <th style="font-size: 14px; vertical-align: middle;">Nomor Memo</th>
                            <th style="font-size: 14px; vertical-align: middle;">Tanggal Pengajuan</th>
                            <th style="font-size: 14px; vertical-align: middle;">Perihal</th>
                            <th style="font-size: 14px; vertical-align: middle;" class="text-center" colspan="3">Status</th>
                        </tr>
                    </thead>
                    <% if (data && data.length > 0) { %>
                    <% data.forEach((item, index) => { %>
                    <tbody id="searchResults">
                        <tr>
                            <td style="font-size: 15px; vertical-align: middle; justify-content: center;" class="text-center pl-2">
                                <%= index + 1 %>
                            </td>
                            <td style="vertical-align: middle;"><%= item.nomor_memo %></td>
                            <td style="vertical-align: middle;">
                                <% if (item.tanggal_pengajuan) { %>
                                <%= new Date(item.tanggal_pengajuan).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year: 'numeric'}).replace(/ /g, '-') %>
                                <% } else { %>
                                <span class="text-muted">-</span>
                                <% } %>
                            </td>
                            <td style="vertical-align: middle;"><%= item.perihal %></td>
                            <td style="text-align: center; vertical-align: middle;">
                                <span
                                    class="badge text-wrap p-2 badge-<%= item.tanggal_reject ? 'danger' : item.is_approve ? 'success' : 'warning' %>"
                                    style="width: 130px; height: 30px;">
                                    <%= item.tanggal_reject ? 'Rejected' : item.is_approve ? 'Approved' : 'Pending Approve' %>
                                </span>
                            </td>
                            <% if (user) { %>
                            <% if (user.role === 1) { %>
                            <!-- Admin -->
                            <td style="text-align: center; vertical-align: middle;">
                                <div class="d-flex flex-wrap justify-content-center" style="gap: 5px;">
                                    <a href="/pengajuanMemoView/<%= item.id_memo %>"
                                        class="btn btn-sm btn-secondary d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/pengajuanMemoEdit/<%= item.id_memo %>"
                                        class="btn btn-sm btn-warning d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;
                                    title=" Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <% if (item.tanggal_approve) { %>
                                    <a href="/pengajuanMemo/printApproved/<%= item.id_memo %>" target="_blank"
                                        style="width: 35px; height: 35px;"
                                        class="btn btn-sm btn-success d-flex align-items-center justify-content-center"
                                        title="Print Approved">
                                        <i class="fas fa-print"></i>
                                    </a>
                                    <% } %>
                                    <% if (item.tanggal_reject) { %>
                                    <a href="/pengajuanMemo/downloadRejected/<%= item.id_memo %>"
                                        class="btn btn-sm btn-danger d-flex align-items-center justify-content-center"
                                        title="Download Rejected" style="width: 35px; height: 35px;">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <% } %>
                                </div>
                            </td>
                            <% } else if (user.role === 13) { %>
                            <!-- IT -->
                            <td>
                                <div class="d-flex flex-wrap justify-content-center" style="gap: 5px;">
                                    <% if (item.is_approve === true) { %>
                                    <a href="/pengajuanMemoView/<%= item.id_memo %>"
                                        class="btn btn-sm btn-secondary d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <% } else { %>
                                    <a href="/pengajuanMemoEdit/<%= item.id_memo %>"
                                        class="btn btn-sm btn-warning  d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <% } %>
                                    <% if (item.tanggal_approve) { %>
                                    <a href="/pengajuanMemo/printApproved/<%= item.id_memo %>" target="_blank"
                                        class="btn btn-sm btn-success d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;" title="Print Approved">
                                        <i class="fas fa-print"></i>
                                    </a>
                                    <% } %>
                                    <% if (item.tanggal_reject) { %>
                                    <a href="/pengajuanMemo/downloadRejected/<%= item.id_memo %>"
                                        class="btn btn-sm btn-danger d-flex align-items-center justify-content-center"
                                        style="width: 35px; height: 35px;" title="Download Rejected">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <% } %>
                                </div>
                            </td>
                            <% } %>
                            <% } %>
                            <td class="align-middle text-center">
                                <div class="d-flex justify-content-center align-items-center pt-3"
                                    style="height: 100%;">
                                    <form action="/pengajuanMemo/printAndSend/<%= item.id_memo %>" method="POST"
                                        target="_blank">
                                        <button type="submit" class="btn btn-sm btn-primary"
                                            style="width: 35px; height: 35px;" title="Download & Send Email">
                                            <i class="fas fa-envelope"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                        <% } else { %>
                        <tr>
                            <td colspan="11" class="text-center">Tidak ada data</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <!---end Table Content-->
            <div class="d-flex justify-content-center mt-3">
                <% const pageLimit = 5; 
                    const startPage = Math.max(1, currentPage - Math.floor(pageLimit / 2));
                    const endPage = Math.min(totalPages, startPage + pageLimit - 1);
                    const queryString = `search=${encodeURIComponent(searchKeyword || '')}&filterDateStart=${filterDateStart || ''}&filterDateEnd=${filterDateEnd || ''}`;
                %>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                        <a class="page-link" href="?page=1&<%= queryString %>">&laquo; First</a>
                        </li>
                        <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= queryString %>">Prev</a>
                        </li>
                    <% } %>

                    <% for (let i = startPage; i <= endPage; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&<%= queryString %>"><%= i %></a>
                        </li>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= queryString %>">Next</a>
                        </li>
                        <li class="page-item">
                        <a class="page-link" href="?page=<%= totalPages %>&<%= queryString %>">Last &raquo;</a>
                        </li>
                    <% } %>
                    </ul>
                </nav>
            </div>
            <br>
            <!---END pagination-->
        </div>
        <!-- end Card Table -->
    </section>
    <div class="modal fade" id="modal-lg" tabindex="-1" , aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content position-relative">
                <div class="modal-header">
                    <h4 class="modal-title">Form Pengajuan Memo</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form action="/createPengajuanMemo" method="POST" id="memoForm">
                    <input type="hidden" name="tempItems" id="tempItems" />
                    <div class="modal-body">
                        <!-- KIRI: Data Peminjam -->
                        <div>
                            <div class="form-group">
                                <label>Dari</label>
                                <select id="dariMemo" name="dariMemo" class="form-control select2">
                                    <option value="">-- Pilih Nama Karyawan --</option>
                                    <% optionKaryawan.forEach(k => { %>
                                    <option value="<%= k.id_karyawan %>">
                                        <%= k.nama_karyawan %>
                                    </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Perihal</label>
                                <input type="text" class="form-control" id="perihal" name="perihal" />
                            </div>
                            <div class="form-group">
                                <label>CC</label>
                                <select id="ccMemo" name="ccMemo" class="form-control select2">
                                    <option value="">-- Pilih Nama Karyawan --</option>
                                    <% optionKaryawan.forEach(k => { %>
                                    <option value="<%= k.id_karyawan %>">
                                        <%= k.nama_karyawan %>
                                    </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Tanggal Pengajuan Memo</label>
                                <input type="date" class="form-control" id="tanggal_memo" name="tanggal_memo" />
                            </div>
                        </div>
                        <div class="mt-0 ml-3 mr-3 mb-0 align-items-center">
                            <div class="form-group row align-items-end " style="gap: 8px;">
                                <div style="width: 20%;">
                                    <label>Item</label>
                                    <input type="text" class="form-control" id="item" name="item" />
                                </div>
                                <div style="width: 15%;">
                                    <label>Link Pembelian</label>
                                    <input type="text" class="form-control" id="link" name="link" />
                                </div>
                                <div style="width: 8%;">
                                    <label>Qty</label>
                                    <input type="number" class="form-control" id="qty" name="qty" />
                                </div>
                                <div style="width: 20%;">
                                    <label>User</label>
                                    <input type="text" class="form-control" id="user_memo" name="user_memo" />
                                </div>
                                <div style="width: 20%;">
                                    <label>Remark</label>
                                    <input type="text" class="form-control" id="remark" name="remark" />
                                </div>
                                <div style="width: 10%;">
                                    <label class="invisible">Tambah</label>
                                    <button type="button" class="btn btn-success" id="btnAddMemo">
                                        Tambah
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="p-2">
                            <div class="card p-2">
                                <div class="card-body p-0" style="overflow-y: auto; max-height: 225px">
                                    <table class="table table-bordered" id="addedItemsTable">
                                        <thead>
                                            <tr>
                                                <th style="width: 30%;">Item</th>
                                                <th style="width: 10%;">Qty</th>
                                                <th style="width: 15%;">User</th>
                                                <th style="width: 25%;">Remark</th>
                                                <th style="width: 10%;">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
</div>
<%- include('layout/footer') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tempItems = [];

        // Tambah item memo
        $('#btnAddMemo').on('click', () => {
            const item = $('#item').val().trim();
            const link = $('#link').val().trim();
            const qty = $('#qty').val().trim();
            const user_memo = $('#user_memo').val().trim();
            const remark = $('#remark').val().trim();

            if (!item || !qty || !user_memo || !link || !remark) {
                return alert('Isi semua kolom Item, Qty, Link, Remark dan User!');
            }

            const row = {
                item,
                link,
                qty,
                user_memo,
                remark
            };
            tempItems.push(row);

            $('#addedItemsTable tbody').append(`
                <tr data-index="${tempItems.length - 1}">
                    <td>
                        <div><strong>${item}</strong></div>
                        <div style="font-size: 0.8em; word-break: break-all;"><a href="${link}" target="_blank">${link}</a></div>
                    </td>
                    <td>${qty}</td>
                    <td>${user_memo}</td>
                    <td>${remark}</td>
                    <td class="text-center justify-content-center"><button type="button" class="btn btn-danger btn-sm btn-remove" style="width: 30px; height: 30px;"><i class="fa fa-times" aria-hidden"true"></i></button></td>
                </tr>
            `);

            $('#item, #link, #qty, #user_memo, #remark').val('');
        });

        // Hapus item memo
        $('#addedItemsTable').on('click', '.btn-remove', function () {
            const row = $(this).closest('tr');
            const index = row.data('index');
            tempItems.splice(index, 1);
            row.remove();

            $('#addedItemsTable tbody tr').each((i, tr) => {
                $(tr).attr('data-index', i);
            });
        });

        // Submit form memo
        $('#memoForm').on('submit', function (e) {
            if (tempItems.length === 0) {
                e.preventDefault();
                return Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: 'Minimal tambahkan 1 item memo!',
                    showConfirmButton: false,
                    timer: 3000
                });
            }
            $('#tempItems').val(JSON.stringify(tempItems));
        });

        // Saat modal dibuka
        $('#modal-lg').on('shown.bs.modal', function () {
            $('.select2').select2({
                dropdownParent: $('#modal-lg')
            });
            $('.select2-selection').attr('style', 'height: 38px; display: flex; padding-left: 8px;');
            $('.select2-selection__arrow').css({
                height: '38px',
                top: '0',
                display: 'flex',
                'align-items': 'center'
            });
        });

        // Reset button
        document.getElementById('resetButton').addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = `/pengajuanMemo`;
        });

        // Filter functionality
        const filterButton = document.getElementById('filterButton');
        const searchInput = document.getElementById('search');
        const startDate = document.getElementById('filterDateStart');
        const endDate = document.getElementById('filterDateEnd');

        function handleFilter() {
            const query = new URLSearchParams();
            if (searchInput.value.trim() !== '') {
                query.append('search', searchInput.value.trim());
            }
            if (startDate.value) {
                query.append('filterDateStart', startDate.value);
            }
            if (endDate.value) {
                query.append('filterDateEnd', endDate.value);
            }
            window.location.href = `/pengajuanMemo?${query.toString()}`;
        }

        filterButton.addEventListener('click', function (e) {
            e.preventDefault();
            handleFilter();
        });

        // Enter untuk trigger Filter
        [searchInput, startDate, endDate].forEach(el => {
            el.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleFilter();
                }
            });
        });
    });
</script>