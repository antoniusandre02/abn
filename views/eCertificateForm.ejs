<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>e-Warranty Registration - Abadi Nusa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #cbd0d8;
            font-family: Arial, sans-serif;
            padding: 2rem;
        }

        .form-container {
            background-color: #fff;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            max-width: 700px;
            margin: 0 auto;
        }

        h2 {
            text-align: center;
            font-weight: bold;
            margin-bottom: 1.5rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-label {
            font-weight: 600;
        }

        .btn-submit {
            background-color: #2eaf7d;
            color: white;
            border: none;
        }

        .alert {
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-weight: bold;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
    </style>
</head>

<body>
    <div class="form-container">
        <a href="#">
            <img src="/adminlte/dist/img/logoabn.png" alt="logo"
                style="max-width: 200px; display: block; margin: 0 auto;">
        </a>
        <h2>e-Warranty Registration</h2>

        <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger"><%= errorMessage[0] %></div>
        <% } %>

        <% if (successMessage && successMessage.length > 0) { %>
        <div class="alert alert-success"><%= successMessage[0] %></div>
        <% } %>

        <form action="/ewarranty/submit" method="POST" enctype="multipart/form-data">
            <!-- Customer Info -->
            <div class="form-group">
                <label class="form-label">Nama Customer</label>
                <input type="text" class="form-control" name="customer_name" required>
            </div>
            <div class="form-group">
                <label class="form-label">Nama Perusahaan / Institusi</label>
                <input type="text" class="form-control" name="company_name" required>
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" required>
            </div>
            <div class="form-group">
                <label class="form-label">Nomor HP</label>
                <input type="text" class="form-control" name="phone" required>
            </div>
            <div class="form-group">
                <label class="form-label">Alamat</label>
                <textarea class="form-control" name="address" rows="2" required></textarea>
            </div>

            <!-- Product Info -->
            <div class="form-group">
                <label class="form-label">Nama Produk</label>
                <input type="text" class="form-control" name="product_name" required>
            </div>
            <div class="form-group">
                <label class="form-label">Tipe Produk</label>
                <input type="text" class="form-control" name="product_type" required>
            </div>
            <div class="form-group">
                <label class="form-label">LOT Number</label>
                <input type="text" class="form-control" name="lot_number">
            </div>
            <div class="form-group">
                <label class="form-label">Serial Number Produk</label>
                <input type="text" class="form-control" name="serial_number" required>
            </div>
            <div class="form-group">
                <label class="form-label">Warna</label>
                <input type="text" class="form-control" name="color">
            </div>

            <!-- Dates -->
            <div class="form-group">
                <label class="form-label">Tanggal Pembelian</label>
                <input type="date" class="form-control" name="purchase_date" required>
            </div>

            <div class="form-group">
                <label class="form-label">Pembelian Dari</label><br>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="purchase_method" value="Online" required>
                    <label class="form-check-label">Online</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="purchase_method" value="Direct">
                    <label class="form-check-label">Direct</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="purchase_method" value="Distributor">
                    <label class="form-check-label">Distributor</label>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Installation Date / Date Received</label>
                <input type="date" class="form-control" name="installation_date" required>
            </div>

            <!-- Upload -->
            <div class="form-group">
                <label class="form-label">Upload Foto Produk / Tanda Terima</label>
                <input type="file" class="form-control" name="attachment" accept=".jpg,.jpeg,.png,.pdf" required>
            </div>

            <button type="submit" class="btn btn-submit w-100 mt-3">Submit Warranty</button>
        </form>
    </div>
</body>

</html>