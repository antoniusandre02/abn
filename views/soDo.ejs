  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <style>
    .pagination a {
      margin: 0 5px;
      text-decoration: none;
      padding: 5px 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    .pagination a.active {
      background-color: #007bff;
      color: white;
      border-color: #007bff;
    }
    html, body {
      height: 100%;
    }

    .wrapper {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .content-wrapper {
      flex: 1;
      padding: 20px;
      background-color: #f4f6f9;
    }

    .main-footer {
      background: #fff;
      border-top: 1px solid #dee2e6;
      color: #6c757d;
      padding: 10px 20px;
      margin-left: 250px; /* Sesuaikan dengan lebar sidebar */
    }



  </style>
<body class="hold-transition sidebar-mini layout-fixed">
  <div class="wrapper">
  <%- include('layout/header') %>
  <%- include('layout/sidebar') %>

  <div class="content-wrapper">
    <% if (successMessage && successMessage.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= successMessage %>
      <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
        &times;
      </button>
    </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= errorMessage %>
      <button type="button" class="btn btn-sm btn-default ms-2" data-bs-dismiss="alert" aria-label="Close">
        &times;
      </button>
    </div>
    <% } %>

    <div class="row p-3">
      <div class="col-12">
        <!-- Tombol Add di atas card -->
        <% if (role === 1 || role === 10 || role === 11) { %>
        <div class="mb-2 text-right">
          <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modal-lg">Add SO / DO</button>
        </div>
        <% } %>

        <div class="modal fade" id="modal-lg">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h4 class="modal-title">Tambah SO / DO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
              <form action="/soDo/create" method="POST">
                <div class="modal-body">
                  <h5 class="mb-2">Lokasi Warehouse</h5>
                  <div class="input-group mb-3 ">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-map-marker"></i></span>
                    </div>
                    <select class="custom-select rounded-0" id="warehouse_location" name="warehouse_location" required>
                      <option value="" disabled selected>-- Pilih Lokasi Warehouse --</option>
                      <% if (optionWarehouseLocation && optionWarehouseLocation.length > 0) { %>
                      <% optionWarehouseLocation.forEach(optionWarehouseLocation => { %>
                      <option value="<%= optionWarehouseLocation.id_warehouse %>">
                        <%= optionWarehouseLocation.location_warehouse %></option>
                      <% }) %>
                      <% } else { %>
                      <option value="" disabled>Pilihan Warehouse Tidak Tersedia</option>
                      <% } %>
                    </select>
                  </div>

                  <h5 class="mb-2">Sales Order Number</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-hashtag"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Input Angka SO Saja" id="sales_order_number"
                      name="sales_order_number" required>
                  </div>

                  <h5 class="mb-2">Sales Order Date</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                    <input type="date" class="form-control" id="sales_order_date" name="sales_order_date" required>
                  </div>

                  <h5 class="mb-2">Delivery Order Number</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-hashtag"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Input Angka DO Saja" id="delivery_order_number"
                      name="delivery_order_number" required>
                  </div>

                  <h5 class="mb-2">Delivery Order Date</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                    <input type="date" class="form-control" id="delivery_order_date" name="delivery_order_date"
                      required>
                  </div>

                  <h5 class="mb-2">Customer Name</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-user"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Customer Name" id="customer_name"
                      name="customer_name" required>
                  </div>

                  <h5 class="mb-2">Divisi</h5>
                  <div class="input-group mb-3 ">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-users"></i></span>
                    </div>
                    <select class="custom-select rounded-0" id="division_team" name="division_team" required>
                      <option value="" disabled selected>-- Pilih Divisi --</option>
                      <% if (optionDivision && optionDivision.length > 0) { %>
                      <% optionDivision.forEach(optionDivision => { %>
                      <option value="<%= optionDivision.id_division %>"><%= optionDivision.name_division %></option>
                      <% }) %>
                      <% } else { %>
                      <option value="" disabled>Tidak ada divisi tersedia</option>
                      <% } %>
                    </select>
                  </div>

                  <h5 class="mb-2">Shipped By</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-file"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Nama Ekspedisi" id="ship_by" name="ship_by">
                  </div>

                  <h5 class="mb-2">Expedition Notes</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-file"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Catatan" id="ekspedisi_note"
                      name="ekspedisi_note">
                  </div>

                  <h5 class="mb-2">Resi Number</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-hashtag"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Nomor Resi" id="resi_number"
                      name="resi_number">
                  </div>

                  <h5 class="mb-2">Weight</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-boxes"></i></span>
                    </div>
                    <input type="text" class="form-control" id="weight" name="weight" placeholder="Berat dalam Kg">
                    <div class="input-group-append">
                      <div class="input-group-text">Kg</div>
                    </div>
                  </div>

                  <h5 class="mb-2">Harga Ongkir</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text">Rp</span>
                    </div>
                    <input type="text" class="form-control" placeholder="Harga Ongkir" id="price" name="price">
                  </div>

                  <h5 class="mb-2">Pickup Date</h5>
                  <div class="input-group mb-3">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                    <input type="date" class="form-control" id="eta" name="eta" required>
                  </div>

                  <h5 class="mb-2">Nama Penerima</h5>
                  <div class="input-group">
                    <div class="input-group-prepend">
                      <span class="input-group-text"><i class="fa fa-user"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Nama Penerima" id="receive_name"
                      name="receive_name">
                  </div>

                </div>
                <div class="modal-footer justify-content-between">
                  <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
              </form>
            </div>
            <!-- /.modal-content -->
          </div>
          <!-- /.modal-dialog -->
        </div>
        <!-- end modal fade -->

        <!-- Card Table -->
        <section class="content p-3">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h3 class="card-title">Monitoring Order</h3>
                <div class="form-inline row g-2">
                  <!-- <form> -->
                    <div class="col-auto">
                      <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="Cari DO / SO">
                    </div>
                    <div class="col-auto">
                      <input type="date" id="filterDateStart" name="filterDateStart" class="form-control form-control-sm">
                    </div>
                    <div class="col-auto">
                      <input type="date" id="filterDateEnd" name="filterDateEnd" class="form-control form-control-sm">
                    </div>
                    <div class="col-auto">
                      <button id="filterButton" class="btn btn-sm btn-primary">Filter</button>
                      <button id="resetButton" class="btn btn-sm btn-secondary">Reset</button>
                    </div>
                  <!-- </form> -->
                </div>
            </div>
            <!---end card-header -->
            <!-- Table Content -->
            <div class="card-body table-responsive">
              <table id="soDoTable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                  <tr>
                    <th>No</th>
                    <th>Sales Order Number</th>
                    <th>Sales Order Date</th>
                    <th>Delivery Order Number</th>
                    <th>Delivery Order Date</th>
                    <th>Invoicing Date</th>
                    <th>Customer</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Ship By</th>
                    <th>ETA</th>
                    <th>Barcode</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="searchResults">
                  <% if (data && data.length > 0) { %>
                  <% data.forEach((item, index) => { %>
                  <tr id="row-<%= item.id_monitoring_data %>">
                    <td><%= index + 1 %></td>
                    <td><%= item.sales_order_number %></td>
                    <td><%= item.sales_order_date.toLocaleDateString() %></td>
                    <td><%= item.delivery_order_number %></td>
                    <td><%= item.delivery_order_date.toLocaleDateString() %></td>
                    <td>
                      <%= item.invoicing_date ? new Date(item.invoicing_date).toLocaleDateString('id-ID') : "Belum diinput oleh Tim Finance" %>
                    </td>
                    <td><%= item.customer_name %></td>
                    <td><%= item.location_warehouse %></td>
                    <td><%= item.status %></td>
                    <td><%= item.ship_by %></td>
                    <td>
                      <%= new Date(item.eta).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    </td>
                    <td><img src="data:image/png;base64,<%= item.barcode_do %>" alt="Barcode DO"
                        style="width: 180px; height: 60px; object-fit: contain; display: block;"> </td>
                    <td>
                      <button onclick="exportRowToPDF(<%= item.id_monitoring_data %>)" class="btn btn-sm btn-info">
                        <i class="fas fa-print"></i>
                      </button>
                      <% if (user && (user.role === 1 || user.role === 8)) { %>
                      <!-- Role Admin & Finance bisa Edit -->
                      <a href="/soDoEdit/<%= item.id_monitoring_data %>" class="btn btn-sm btn-warning" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% } else if (user && (user.role === 10 || user.role === 11)) { %>
                      <!-- Role Admin Gudang Kopo & Saleh hanya bisa lihat detail -->
                      <a href="/soDoView/<%= item.id_monitoring_data %>" class="btn btn-sm btn-secondary" title="Detail">
                        <i class="fas fa-eye"></i>
                      </a>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                  <% } else { %>
                  <tr>
                    <td colspan="11" class="text-center">Tidak ada data</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <!---end Table Content-->
            <div class="d-flex justify-content-end mt-3">
              <% const pageLimit = 5; 
              const startPage = Math.max(1, currentPage - Math.floor(pageLimit / 2));
              const endPage = Math.min(totalPages, startPage + pageLimit - 1);
              %>
              <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=1&search=<%= searchKeyword %>">&laquo; First</a>
                    </li>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= searchKeyword %>">Prev</a>
                    </li>
                  <% } %>
                  <% for (let i = startPage; i <= endPage; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&search=<%= searchKeyword %>"><%= i %></a>
                    </li>
                  <% } %>
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= searchKeyword %>">Next</a>
                    </li>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= totalPages %>&search=<%= searchKeyword %>">Last &raquo;</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            </div>
          <br>
          <!---END pagination-->
          </div>
        <!-- end Card Table -->
        </section>
      </div>
      <!---END COL-12 -->
    </div>
    <!---END row p-3 -->
  </div>
  <!--end content wrapper-->
</div>
  <%- include('layout/footer') %>
  </div>
</body>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode"></script>
  <script>
    document.getElementById('resetButton').addEventListener('click', function (e) {
      e.preventDefault();
      document.getElementById('searchInput').value = '';
      document.getElementById('startDate').value = '';
      document.getElementById('endDate').value = '';
      document.querySelector('form').submit();
    });
  </script>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const filterButton = document.getElementById('filterButton');
    const searchInput = document.getElementById('search');
    const startDate = document.getElementById('filterDateStart');
    const endDate = document.getElementById('filterDateEnd');

    filterButton.addEventListener('click', function (e) {
      e.preventDefault(); // Hindari submit form default

      const query = new URLSearchParams();

      if (searchInput.value.trim() !== '') {
        query.append('search', searchInput.value.trim());
      }
      if (startDate.value) {
        query.append('filterDateStart', startDate.value);
      }
      if (endDate.value) {
        query.append('filterDateEnd', endDate.value);
      }

      window.location.href = `/soDo?${query.toString()}`;
      });
    });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      <% if (data && data.length > 0) { %>
        <% data.forEach(item => { %>
          JsBarcode("#barcode-<%item.id_monitoring_data%>", "<%= item.delivery_order_number %>", {
            format: "CODE128",
            displayValue: true,
            width: 2,
            height: 40,
          })
        <% });%>
      <% } %>
    });
  </script>
  <script>
  async function exportRowToPDF(id) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: [45, 15] });

    const row = document.querySelector(`#row-${id}`);
    if (!row) {
      alert("Data tidak ditemukan!");
      return;
    }

    const barcodeImg = row.querySelector("img");
    if (!barcodeImg || !barcodeImg.src.startsWith("data:image")) {
      alert("Barcode tidak ditemukan!");
      return;
    }

    const imgProps = doc.getImageProperties(barcodeImg.src);
    const imgWidth = 35; // 35mm lebar barcode
    const imgHeight = (imgProps.height * imgWidth) / imgProps.width;
    const xCenter = (45 - imgWidth) / 2;
    const yCenter = (15 - imgHeight) / 2;

    doc.addImage(barcodeImg.src, 'PNG', xCenter, yCenter, imgWidth, imgHeight);

    doc.save(`barcode-monitoring-detail-${doNumber}.pdf`);
  }
</script>