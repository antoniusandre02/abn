<%- include('layout/header') %>
<%- include('layout/sidebar') %>

<div class="content-wrapper p-3">
    <div class="container">
        <h4 class="text-center">View Pengajuan Memo</h4>
        <%
            function formatDateInput(date) {
                if (!date) return '';
                const d = new Date(date);
                const y = d.getFullYear();
                const m = ('0' + (d.getMonth() + 1)).slice(-2);
                const da = ('0' + d.getDate()).slice(-2);
                return `${y}-${m}-${da}`;
            }
        %>
        <form action="/pengajuanMemo/update/<%= memo.id_memo %>" method="POST" id="memoForm">
            <input type="hidden" name="tempItems" id="tempItems" />

            <div class="form-group">
                <label>Nomor Memo</label>
                <input type="text" class="form-control" value="<%= memo.nomor_memo || '-' %>" readonly />
            </div>

            <div class="form-group">
                <label>Dari</label>
                <input type="text" class="form-control" value="<%= memo.dari_nama || '-' %>" readonly />
            </div>

            <div class="form-group">
                <label>Perihal</label>
                <input type="text" class="form-control" name="perihal" value="<%= memo.perihal %>" readonly />
            </div>
            
            <div class="form-group">
                <label>CC</label>
                <input type="text" class="form-control" value="<%= memo.cc_nama || '-' %>" readonly />
            </div>

            <div class="form-group">
                <label>Tanggal Pengajuan Memo</label>
                <input type="date" class="form-control" name="tanggal_memo"
                    value="<%= formatDateInput(memo.tanggal_pengajuan) %>" readonly />
            </div>

            <!-- Tabel detail -->
            <div class="mt-3 card">
                <div class="card-body p-2">
                    <table class="table table-bordered" id="addedItemsTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Link</th>
                                <th>Qty</th>
                                <th>User</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% details.forEach((d, i) => { %>
                            <tr data-index="<%= i %>">
                                <td><input type="text" class="form-control" value="<%= d.item %>" readonly/></td>
                                <td><input type="text" class="form-control" value="<%= d.link %>" readonly/></td>
                                <td><input type="number" class="form-control" value="<%= d.jumlah %>" readonly/></td>
                                <td><input type="text" class="form-control" value="<%= d.user_memo %>" readonly/></td>
                                <td><input type="text" class="form-control" value="<%= d.keterangan %>" readonly/></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="form-group mt-3">
                <a href="/pengajuanMemo" class="btn btn-secondary">Kembali</a>
            </div>
        </form>
    </div>
</div>

<%- include('layout/footer') %>

<script>
    let tempItems = <%- JSON.stringify(details.map(d => ({
        item: d.item,
        link: d.link,
        qty: d.jumlah,
        user_memo: d.user_memo,
        remark: d.keterangan
    }))) %>;

    function renderTable() {
        const tbody = $('#addedItemsTable tbody');
        tbody.empty();
        tempItems.forEach((item, index) => {
            tbody.append(`
                <tr data-index="${index}">
                    <td><input type="text" class="form-control" value="${item.item}" readonly/></td>
                    <td><input type="text" class="form-control" value="${item.link}" readonly/></td>
                    <td><input type="number" class="form-control" value="${item.qty}" readonly/></td>
                    <td><input type="text" class="form-control" value="${item.user_memo}" readonly/></td>
                    <td><input type="text" class="form-control" value="${item.remark}" readonly/></td>
                </tr>
            `);
        });
    }

    $('#btnAddItem').on('click', () => {
        const item = $('#item').val().trim();
        const link = $('#link').val().trim();
        const qty = $('#qty').val().trim();
        const user_memo = $('#user_memo').val().trim();
        const remark = $('#remark').val().trim();

        if (!item || !qty || !user_memo) {
            return alert('Item, Qty, dan User harus diisi!');
        }

        tempItems.push({ item, link, qty, user_memo, remark });
        renderTable();
        $('#item, #link, #qty, #user_memo, #remark').val('');
    });


    $('#memoForm').on('submit', function (e) {
        const rows = $('#addedItemsTable tbody tr');
        tempItems = [];

        rows.each(function () {
            const item = $(this).find('td:eq(0) input').val().trim();
            const link = $(this).find('td:eq(1) input').val().trim();
            const qty = $(this).find('td:eq(2) input').val().trim();
            const user_memo = $(this).find('td:eq(3) input').val().trim();
            const remark = $(this).find('td:eq(4) input').val().trim();

            if (item && qty && user_memo) {
                tempItems.push({ item, link, qty, user_memo, remark });
            }
        });

        if (tempItems.length === 0) {
            e.preventDefault();
            return alert('Minimal tambahkan 1 item!');
        }

        $('#tempItems').val(JSON.stringify(tempItems));
    });

    // Render awal saat halaman diload
    $(document).ready(() => {
        renderTable();
    });
</script>
